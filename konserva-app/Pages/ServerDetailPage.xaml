<Page
    x:Class="Konserva.Pages.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Konserva.Controls"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="">

    <Grid Margin="20,0,20,16" RowDefinitions="Auto,Auto,*">
        <!--  Заголовок с кнопками управления  -->
        <Border Grid.Row="0" Margin="0,16">
            <Grid ColumnDefinitions="*,Auto">
                <!--  Название сервера  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock
                            x:Name="ServerNameText"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="ServerName" />
                        <ui:TextBlock
                            x:Name="ServerInfoText"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorDisabledBrush}"
                            Text="1.0.0 • ModloaderName" />
                    </StackPanel>
                    <!--  Уведомление о доступном обновлении загрузчика  -->
                    <ui:Button
                        x:Name="UpdateAvailableButton"
                        Margin="12,0,0,0"
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="UpdateAvailable_Click"
                        Visibility="Collapsed">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                            Symbol="ArrowClockwise20" />
                    </ui:Button>
                </StackPanel>

                <!--  Кнопки управления  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Старт/Стоп  -->
                    <ui:Button
                        x:Name="StartStopButton"
                        Padding="8,4,12,4"
                        Click="StartStop_Click"
                        ToolTip="{loc:Loc ServerDetail_StartStop}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="StartStopIcon"
                                FontSize="20"
                                Symbol="Play20" />
                            <Grid
                                x:Name="StartStopPulse"
                                Width="20"
                                Height="20"
                                Visibility="Collapsed">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{ui:ThemeResource SystemFillColorCautionBrush}" />
                            </Grid>
                            <ui:TextBlock
                                x:Name="StartStopText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{loc:Loc ServerDetail_Start}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Открыть папку  -->
                    <ui:Button
                        Margin="8,0,8,0"
                        Padding="4"
                        Click="OpenFolder_Click"
                        ToolTip="{loc:Loc ServerDetail_OpenFolder}">
                        <ui:SymbolIcon FontSize="20" Symbol="Folder20" />
                    </ui:Button>

                    <!--  Удалить  -->
                    <ui:Button
                        Padding="4"
                        Click="Delete_Click"
                        ToolTip="{loc:Loc ServerDetail_Delete}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                            Symbol="Delete20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Навигация по разделам сервера  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Background="{ui:ThemeResource ControlFillColorTertiaryBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!--  Левая группа кнопок (Консоль, Моды, Плагины)  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!--  Консоль  -->
                    <ui:Button
                        x:Name="ConsoleNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="4,0,0,4"
                        Tag="Console"
                        ToolTip="{loc:Loc ServerDetail_Console}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ConsoleNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="WindowConsole20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Console}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Моды  -->
                    <ui:Button
                        x:Name="ModsNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Mods"
                        ToolTip="{loc:Loc ServerDetail_Mods}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ModsNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="CubeAdd20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Mods}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Плагины  -->
                    <ui:Button
                        x:Name="PluginsNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Plugins"
                        ToolTip="{loc:Loc ServerDetail_Plugins}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="PluginsNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="LightbulbFilament20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Plugins}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!--  Правая группа кнопок (Свойства, Настройки)  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--  Свойства  -->
                    <ui:Button
                        x:Name="PropertiesNavButton"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Properties"
                        ToolTip="{loc:Loc ServerDetail_Properties}">
                        <ui:SymbolIcon
                            x:Name="PropertiesNavIcon"
                            FontSize="20"
                            Symbol="DocumentText20" />
                    </ui:Button>

                    <!--  Настройки  -->
                    <ui:Button
                        x:Name="SettingsNavButton"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0,4,4,0"
                        Tag="Settings"
                        ToolTip="{loc:Loc ServerDetail_Settings}">
                        <ui:SymbolIcon
                            x:Name="SettingsNavIcon"
                            FontSize="20"
                            Symbol="TaskListSquareSettings20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Содержимое разделов  -->
        <Border Grid.Row="2" CornerRadius="8">
            <Grid>
                <!--  Консоль  -->
                <Grid x:Name="ConsoleHost" Visibility="Visible" />
                <!--  Моды  -->
                <Grid x:Name="ModsHost" Visibility="Collapsed" />
                <!--  Плагины  -->
                <Grid x:Name="PluginsHost" Visibility="Collapsed" />
                <!--  Свойства сервера (server.properties)  -->
                <Grid x:Name="PropertiesView" Visibility="Collapsed">
                    <controls:ServerPropertiesEditor x:Name="PropertiesEditor" />
                </Grid>
                <!--  Настройки сервера  -->
                <Grid x:Name="SettingsHost" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>