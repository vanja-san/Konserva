<Page
    x:Class="Konserva.Pages.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Konserva.Controls"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="">

    <Grid Margin="20,0,20,16" RowDefinitions="Auto,Auto,*">
        <!--  Header with control buttons  -->
        <Border Grid.Row="0" Margin="0,16">
            <Grid ColumnDefinitions="*,Auto">
                <!--  Server name  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock
                            x:Name="ServerNameText"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="ServerName" />
                        <ui:TextBlock
                            x:Name="ServerInfoText"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorDisabledBrush}"
                            Text="1.0.0 • ModloaderName" />
                    </StackPanel>
                    <!--  Loader update available notification  -->
                    <ui:Button
                        x:Name="UpdateAvailableButton"
                        Margin="12,0,0,0"
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="UpdateAvailable_Click"
                        Visibility="Collapsed">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                            Symbol="ArrowClockwise20" />
                    </ui:Button>
                </StackPanel>

                <!--  Control buttons  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Start/Stop  -->
                    <ui:Button
                        x:Name="StartStopButton"
                        Padding="8,4,12,4"
                        Click="StartStop_Click"
                        ToolTip="{loc:Loc ServerDetail_StartStop}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="StartStopIcon"
                                FontSize="20"
                                Symbol="Play20" />
                            <Grid
                                x:Name="StartStopPulse"
                                Width="20"
                                Height="20"
                                Visibility="Collapsed">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{ui:ThemeResource SystemFillColorCautionBrush}" />
                            </Grid>
                            <ui:TextBlock
                                x:Name="StartStopText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{loc:Loc ServerDetail_Start}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Open folder  -->
                    <ui:Button
                        Margin="8,0,8,0"
                        Padding="4"
                        Click="OpenFolder_Click"
                        ToolTip="{loc:Loc ServerDetail_OpenFolder}">
                        <ui:SymbolIcon FontSize="20" Symbol="Folder20" />
                    </ui:Button>

                    <!--  Delete  -->
                    <ui:Button
                        Padding="4"
                        Click="Delete_Click"
                        ToolTip="{loc:Loc ServerDetail_Delete}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                            Symbol="Delete20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Server section navigation  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Background="{ui:ThemeResource ControlFillColorTertiaryBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!--  Left button group (Console, Mods, Plugins)  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!--  Console  -->
                    <ui:Button
                        x:Name="ConsoleNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="4,0,0,4"
                        Tag="Console"
                        ToolTip="{loc:Loc ServerDetail_Console}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ConsoleNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="WindowConsole20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Console}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Mods  -->
                    <ui:Button
                        x:Name="ModsNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Mods"
                        ToolTip="{loc:Loc ServerDetail_Mods}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ModsNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="CubeAdd20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Mods}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Plugins  -->
                    <ui:Button
                        x:Name="PluginsNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Plugins"
                        ToolTip="{loc:Loc ServerDetail_Plugins}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="PluginsNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="LightbulbFilament20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Plugins}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!--  Right button group (Properties, Settings)  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--  Properties  -->
                    <ui:Button
                        x:Name="PropertiesNavButton"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Properties"
                        ToolTip="{loc:Loc ServerDetail_Properties}">
                        <ui:SymbolIcon
                            x:Name="PropertiesNavIcon"
                            FontSize="20"
                            Symbol="DocumentText20" />
                    </ui:Button>

                    <!--  Settings  -->
                    <ui:Button
                        x:Name="SettingsNavButton"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0,4,4,0"
                        Tag="Settings"
                        ToolTip="{loc:Loc ServerDetail_Settings}">
                        <ui:SymbolIcon
                            x:Name="SettingsNavIcon"
                            FontSize="20"
                            Symbol="TaskListSquareSettings20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Section content  -->
        <Border Grid.Row="2" CornerRadius="8">
            <Grid>
                <!--  Console  -->
                <Grid x:Name="ConsoleHost" Visibility="Visible" />
                <!--  Mods  -->
                <Grid x:Name="ModsHost" Visibility="Collapsed" />
                <!--  Plugins  -->
                <Grid x:Name="PluginsHost" Visibility="Collapsed" />
                <!--  Server properties (server.properties)  -->
                <Grid x:Name="PropertiesView" Visibility="Collapsed">
                    <controls:ServerPropertiesEditor x:Name="PropertiesEditor" />
                </Grid>
                <!--  Server settings  -->
                <Grid x:Name="SettingsHost" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>