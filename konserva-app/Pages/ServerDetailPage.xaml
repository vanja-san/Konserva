<Page
    x:Class="Konserva.Pages.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:controls="clr-namespace:Konserva.Controls"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="">

    <Grid Margin="20,0,20,16" RowDefinitions="Auto,Auto,*">
        <!--  Заголовок с кнопками управления  -->
        <Border Grid.Row="0" Margin="0,16">
            <Grid ColumnDefinitions="*,Auto">
                <!--  Название сервера  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock
                            x:Name="ServerNameText"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="ServerName" />
                        <ui:TextBlock
                            x:Name="ServerInfoText"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorDisabledBrush}"
                            Text="1.0.0 • ModloaderName" />
                    </StackPanel>
                </StackPanel>

                <!--  Кнопки управления  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Старт/Стоп  -->
                    <ui:Button
                        x:Name="StartStopButton"
                        Padding="8,4,12,4"
                        Click="StartStop_Click"
                        ToolTip="{loc:Loc ServerDetail_StartStop}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="StartStopIcon"
                                FontSize="20"
                                Symbol="Play20" />
                            <Grid
                                x:Name="StartStopPulse"
                                Width="20"
                                Height="20"
                                Visibility="Collapsed">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="#F59E0B" />
                            </Grid>
                            <ui:TextBlock
                                x:Name="StartStopText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{loc:Loc ServerDetail_Start}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Открыть папку  -->
                    <ui:Button
                        Margin="8,0,8,0"
                        Padding="4"
                        Click="OpenFolder_Click"
                        ToolTip="{loc:Loc ServerDetail_OpenFolder}">
                        <ui:SymbolIcon FontSize="20" Symbol="Folder20" />
                    </ui:Button>

                    <!--  Удалить  -->
                    <ui:Button
                        Padding="4"
                        Click="Delete_Click"
                        ToolTip="{loc:Loc ServerDetail_Delete}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                            Symbol="Delete20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Навигация по разделам сервера  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Background="{ui:ThemeResource ControlFillColorTertiaryBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!--  Левая группа кнопок (Консоль, Моды, Плагины)  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!--  Консоль  -->
                    <ui:Button
                        x:Name="ConsoleNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="4,0,0,4"
                        Tag="Console"
                        ToolTip="{loc:Loc ServerDetail_Console}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ConsoleNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="WindowConsole20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Console}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Моды  -->
                    <ui:Button
                        x:Name="ModsNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Mods"
                        ToolTip="{loc:Loc ServerDetail_Mods}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ModsNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="CubeAdd20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Mods}" />
                        </StackPanel>
                    </ui:Button>

                    <!--  Плагины  -->
                    <ui:Button
                        x:Name="PluginsNavButton"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Plugins"
                        ToolTip="{loc:Loc ServerDetail_Plugins}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="PluginsNavIcon"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="LightbulbFilament20" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{loc:Loc ServerDetail_Plugins}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!--  Правая группа кнопок (Свойства, Настройки)  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--  Свойства  -->
                    <ui:Button
                        x:Name="PropertiesNavButton"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0"
                        Tag="Properties"
                        ToolTip="{loc:Loc ServerDetail_Properties}">
                        <ui:SymbolIcon
                            x:Name="PropertiesNavIcon"
                            FontSize="20"
                            Symbol="DocumentText20" />
                    </ui:Button>

                    <!--  Настройки  -->
                    <ui:Button
                        x:Name="SettingsNavButton"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavigationButton_Click"
                        CornerRadius="0,4,4,0"
                        Tag="Settings"
                        ToolTip="{loc:Loc ServerDetail_Settings}">
                        <ui:SymbolIcon
                            x:Name="SettingsNavIcon"
                            FontSize="20"
                            Symbol="TaskListSquareSettings20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Содержимое разделов  -->
        <Border Grid.Row="2" CornerRadius="8">
            <Grid>
                <!--  Консоль  -->
                <Grid
                    x:Name="ConsoleView"
                    RowDefinitions="*,Auto"
                    Visibility="Visible">
                    <!--  Лог сервера  -->
                    <Border
                        Grid.Row="0"
                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <avalon:TextEditor
                            x:Name="LogBox"
                            Padding="8"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            IsVisibleChanged="LogBox_IsVisibleChanged"
                            ShowLineNumbers="False"
                            VerticalScrollBarVisibility="Auto"
                            WordWrap="False" />
                    </Border>
                    <!--  Placeholder для пустой консоли  -->
                    <ui:TextBlock
                        x:Name="ConsolePlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="{loc:Loc ServerDetail_Console_Empty}" />
                    <!--  Ввод команды  -->
                    <Grid
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        ColumnDefinitions="*,Auto">
                        <ui:TextBox x:Name="CommandBox" KeyDown="CommandBox_KeyDown" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="20,8"
                            Click="SendCommand_Click"
                            Content="{loc:Loc ServerDetail_SendCommand}" />
                    </Grid>
                </Grid>

                <!--  Моды  -->
                <Grid
                    x:Name="ModsView"
                    RowDefinitions="Auto,*"
                    Visibility="Collapsed">
                    <!--  Тулбар  -->
                    <Border
                        Grid.Row="0"
                        Padding="12,8,8,8"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Filled="True"
                                    FontSize="20"
                                    Symbol="AppsListDetail20" />
                                <ui:TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{loc:Loc ServerDetail_Mods_List}" />
                                <ui:InfoBadge
                                    x:Name="ModsCountBadge"
                                    Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Value="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    x:Name="ToggleAllModsBtn"
                                    Height="32"
                                    Padding="8,0,8,0"
                                    Click="ToggleAllMods_Click"
                                    ToolTip="{loc:Loc ServerDetail_Mods_ToggleAll}">
                                    <ui:TextBlock Text="{loc:Loc ServerDetail_Mods_ToggleAll_Enable}" />
                                </ui:Button>
                                <ui:Button
                                    x:Name="OpenModsFolderBtn"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,8,0"
                                    Padding="0"
                                    Click="OpenModsFolder_Click"
                                    ToolTip="{loc:Loc ServerDetail_Mods_OpenFolder}">
                                    <ui:SymbolIcon FontSize="20" Symbol="FolderOpen20" />
                                </ui:Button>
                                <ui:Button
                                    x:Name="RefreshModsBtn"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="RefreshMods_Click"
                                    ToolTip="{loc:Loc ServerDetail_Mods_Refresh}">
                                    <ui:SymbolIcon FontSize="20" Symbol="ArrowClockwise20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Список модов  -->
                    <Border
                        Grid.Row="1"
                        Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,4,4">
                        <ScrollViewer
                            Margin="12,12,0,12"
                            Padding="0,0,12,0"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ModsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardControl
                                            Margin="0,0,0,8"
                                            Padding="12,8,8,8"
                                            ContextMenuOpening="ModCard_ContextMenuOpening"
                                            Opacity="{Binding Enabled, Converter={StaticResource BoolToOpacity}}"
                                            Tag="{Binding}">
                                            <ui:CardControl.Icon>
                                                <ui:SymbolIcon
                                                    Filled="True"
                                                    FontSize="20"
                                                    Symbol="Cube20" />
                                            </ui:CardControl.Icon>
                                            <ui:CardControl.Header>
                                                <ui:TextBlock
                                                    FontSize="14"
                                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </ui:CardControl.Header>
                                            <ui:CardControl.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem
                                                        Click="DeleteMod_Click"
                                                        Header="{loc:Loc ServerDetail_Mods_Delete}"
                                                        Tag="{Binding}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" Symbol="Delete20" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </ui:CardControl.ContextMenu>
                                            <ui:Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="ModMoreMenu_Click"
                                                Tag="{Binding}">
                                                <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal20" />
                                            </ui:Button>
                                        </ui:CardControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!--  Плагины  -->
                <Grid
                    x:Name="PluginsView"
                    RowDefinitions="Auto,*"
                    Visibility="Collapsed">
                    <!--  Тулбар  -->
                    <Border
                        Grid.Row="0"
                        Padding="12,8,8,8"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Filled="True"
                                    FontSize="20"
                                    Symbol="AppsListDetail20" />
                                <ui:TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{loc:Loc ServerDetail_Plugins_List}" />
                                <ui:InfoBadge
                                    x:Name="PluginsCountBadge"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Value="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    x:Name="ToggleAllPluginsBtn"
                                    Height="32"
                                    Padding="8,0,8,0"
                                    Click="ToggleAllPlugins_Click"
                                    ToolTip="{loc:Loc ServerDetail_Plugins_ToggleAll}">
                                    <ui:TextBlock Text="{loc:Loc ServerDetail_Plugins_ToggleAll_Enable}" />
                                </ui:Button>
                                <ui:Button
                                    x:Name="OpenPluginsFolderBtn"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,8,0"
                                    Padding="0"
                                    Click="OpenPluginsFolder_Click"
                                    ToolTip="{loc:Loc ServerDetail_Plugins_OpenFolder}">
                                    <ui:SymbolIcon FontSize="20" Symbol="FolderOpen20" />
                                </ui:Button>
                                <ui:Button
                                    x:Name="RefreshPluginsBtn"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="RefreshPlugins_Click"
                                    ToolTip="{loc:Loc ServerDetail_Plugins_Refresh}">
                                    <ui:SymbolIcon FontSize="20" Symbol="ArrowClockwise20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Список плагинов  -->
                    <Border
                        Grid.Row="1"
                        Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,4,4">
                        <ScrollViewer
                            Margin="12,12,0,12"
                            Padding="0,0,12,0"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PluginsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardControl
                                            Margin="0,0,0,8"
                                            Padding="12,8,8,8"
                                            ContextMenuOpening="PluginCard_ContextMenuOpening"
                                            Opacity="{Binding Enabled, Converter={StaticResource BoolToOpacity}}"
                                            Tag="{Binding}">
                                            <ui:CardControl.Icon>
                                                <ui:SymbolIcon
                                                    Filled="True"
                                                    FontSize="20"
                                                    Symbol="LightbulbFilament20" />
                                            </ui:CardControl.Icon>
                                            <ui:CardControl.Header>
                                                <ui:TextBlock
                                                    FontSize="14"
                                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </ui:CardControl.Header>
                                            <ui:CardControl.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem
                                                        Click="DeletePlugin_Click"
                                                        Header="{loc:Loc ServerDetail_Plugins_Delete}"
                                                        Tag="{Binding}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" Symbol="Delete20" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </ui:CardControl.ContextMenu>
                                            <ui:Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PluginMoreMenu_Click"
                                                Tag="{Binding}">
                                                <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal20" />
                                            </ui:Button>
                                        </ui:CardControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!--  Свойства сервера (server.properties)  -->
                <Grid x:Name="PropertiesView" Visibility="Collapsed">
                    <controls:ServerPropertiesEditor x:Name="PropertiesEditor" />
                </Grid>

                <!--  Настройки сервера  -->
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!--  Баннер: сервер запущен  -->
                            <Border
                                x:Name="SettingsRunningBanner"
                                Margin="0,0,0,8"
                                Padding="12,10"
                                Background="{ui:ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="6"
                                Visibility="Collapsed">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        Filled="True"
                                        FontSize="20"
                                        Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                        Symbol="Warning48" />
                                    <ui:TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{loc:Loc ServerDetail_Settings_RunningWarning}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!--  Основные настройки  -->
                            <ui:CardExpander
                                Margin="0,0,0,8"
                                Padding="12"
                                ContentPadding="8"
                                IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon
                                        Filled="True"
                                        FontSize="20"
                                        Symbol="TaskListSquaresettings20" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerProperties_General}" />
                                        <ui:TextBlock
                                            x:Name="GeneralSaveStatus"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <Grid Margin="8,0" RowDefinitions="Auto">
                                    <Grid
                                        Grid.Row="0"
                                        Margin="0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <ui:TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{loc:Loc ServerDetail_Settings_General}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Settings_General_Desc}" />
                                        </StackPanel>
                                        <ui:TextBox
                                            x:Name="SettingName"
                                            Grid.Column="1"
                                            MinWidth="200"
                                            MaxWidth="250"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            LostFocus="Setting_LostFocus"
                                            MaxLength="50" />
                                    </Grid>
                                </Grid>
                            </ui:CardExpander>

                            <!--  Выделение памяти  -->
                            <ui:CardExpander
                                Margin="0,0,0,8"
                                Padding="12"
                                ContentPadding="8"
                                IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon
                                        Filled="True"
                                        FontSize="20"
                                        Symbol="Storage20" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Settings_RAM}" />
                                        <ui:TextBlock
                                            x:Name="RamSaveStatus"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <Grid Margin="8,0" RowDefinitions="Auto,Auto">
                                    <Grid
                                        Grid.Row="0"
                                        Margin="0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <ui:TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{loc:Loc ServerDetail_Settings_RAM_Min}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Settings_RAM_Min_Desc}" />
                                        </StackPanel>
                                        <ui:TextBox
                                            x:Name="SettingRamMin"
                                            Grid.Column="1"
                                            Width="100"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            LostFocus="Setting_LostFocus"
                                            PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                                            TextAlignment="Center" />
                                    </Grid>
                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Vertical">
                                            <ui:TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{loc:Loc ServerDetail_Settings_RAM_Max}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Settings_RAM_Max_Desc}" />
                                        </StackPanel>
                                        <ui:TextBox
                                            x:Name="SettingRamMax"
                                            Grid.Column="1"
                                            Width="100"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            LostFocus="Setting_LostFocus"
                                            PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </ui:CardExpander>

                            <!--  Авто-рестарт  -->
                            <ui:CardExpander
                                Margin="0,0,0,8"
                                Padding="12"
                                ContentPadding="8"
                                IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon
                                        Filled="True"
                                        FontSize="20"
                                        Symbol="Power20" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Settings_AutoRestart}" />
                                        <ui:TextBlock
                                            x:Name="AutoRestartSaveStatus"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <Grid Margin="8,0" RowDefinitions="Auto,Auto">
                                    <Grid
                                        Grid.Row="0"
                                        Margin="0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_AutoRestart_Enable}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Settings_AutoRestart_Desc}" />
                                        </StackPanel>
                                        <CheckBox
                                            x:Name="SettingAutoRestart"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="Setting_Click" />
                                    </Grid>
                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,8"
                                        ColumnDefinitions="*,200">
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_AutoRestart_Delay}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Settings_AutoRestart_Delay_Desc}" />
                                        </StackPanel>
                                        <ui:TextBox
                                            x:Name="SettingAutoRestartDelay"
                                            Grid.Column="1"
                                            MinWidth="100"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            LostFocus="Setting_LostFocus"
                                            PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </ui:CardExpander>

                            <!--  Настройки Java  -->
                            <ui:CardExpander
                                Margin="0,0,0,8"
                                Padding="12"
                                ContentPadding="8"
                                IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon
                                        Filled="True"
                                        FontSize="20"
                                        Symbol="SquareHintApps20" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Java}" />
                                        <ui:TextBlock
                                            x:Name="JavaSaveStatus"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <Grid Margin="8,0" RowDefinitions="Auto,Auto,Auto">
                                    <Grid
                                        Grid.Row="0"
                                        Margin="0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_Java_Auto}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Settings_Java_Auto_Desc}" />
                                        </StackPanel>
                                        <CheckBox
                                            x:Name="SettingJavaAutoSelect"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="Setting_Click"
                                            IsChecked="True" />
                                    </Grid>
                                    <Grid
                                        x:Name="JavaSelectionGrid"
                                        Grid.Row="1"
                                        Margin="0,8"
                                        ColumnDefinitions="150,*">
                                        <ui:TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="{loc:Loc ServerDetail_Settings_Java_Version}" />
                                        <ComboBox
                                            x:Name="SettingJavaComboBox"
                                            Grid.Column="1"
                                            MinWidth="200"
                                            HorizontalAlignment="Right"
                                            SelectionChanged="SettingJavaComboBox_SelectionChanged" />
                                    </Grid>

                                    <!--  JVM аргументы  -->
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_JvmArgs}" />
                                                <ui:TextBlock
                                                    FontSize="11"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{loc:Loc ServerDetail_Settings_JvmArgs_Desc}" />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="SettingJvmArgs"
                                                Grid.Row="1"
                                                MinHeight="100"
                                                AcceptsReturn="True"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                LostFocus="SettingJvmArgs_LostFocus"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ui:CardExpander>

                            <!--  UPnP Проброс порта  -->
                            <ui:CardExpander
                                Margin="0,0,0,8"
                                Padding="12"
                                ContentPadding="8"
                                IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon
                                        Filled="True"
                                        FontSize="20"
                                        Symbol="Wifi120" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Upnp}" />
                                        <ui:TextBlock
                                            x:Name="UpnpSaveStatus"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <Grid Margin="8,0" RowDefinitions="Auto,Auto,Auto">

                                    <!--  Row 0: вкл/выкл UPnP  -->
                                    <Grid
                                        Grid.Row="0"
                                        Margin="0,16"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Upnp_Enable}" />
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc ServerDetail_Upnp_Enable_Desc}" />
                                        </StackPanel>
                                        <CheckBox
                                            x:Name="SettingEnableUpnp"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="SettingEnableUpnp_Click" />
                                    </Grid>

                                    <!--  Row 1: результат + кнопки проверки  -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="UpnpCheckResultText"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Visibility="Collapsed" />
                                        <ui:SymbolIcon
                                            x:Name="UpnpCheckResultIcon"
                                            Margin="0,0,12,0"
                                            Filled="True"
                                            FontSize="20"
                                            Visibility="Collapsed" />
                                        <ui:Button
                                            x:Name="CheckUpnpButton"
                                            MinWidth="120"
                                            Margin="0,0,8,0"
                                            Click="CheckUpnpButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:ProgressRing
                                                    x:Name="CheckUpnpProgress"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    IsIndeterminate="True"
                                                    Visibility="Collapsed" />
                                                <TextBlock
                                                    x:Name="CheckUpnpText"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:Loc ServerDetail_Upnp_Check}" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button
                                            x:Name="CheckPortButton"
                                            MinWidth="120"
                                            Appearance="Primary"
                                            Click="CheckPortButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:ProgressRing
                                                    x:Name="CheckPortProgress"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    IsIndeterminate="True"
                                                    Visibility="Collapsed" />
                                                <TextBlock
                                                    x:Name="CheckPortText"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:Loc ServerDetail_Upnp_CheckPort}" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>

                                    <!--  Row 2: адрес  -->
                                    <Grid
                                        Grid.Row="2"
                                        Margin="0,0,0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:TextBlock
                                                x:Name="UpnpAddressText"
                                                FontSize="13"
                                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                        <ui:Button
                                            x:Name="CopyAddressButton"
                                            Grid.Column="1"
                                            MinWidth="100"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="CopyAddressButton_Click"
                                            Content="{loc:Loc ServerDetail_Upnp_CopyAddress}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                            </ui:CardExpander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
