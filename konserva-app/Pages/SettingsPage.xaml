<Page
    x:Class="Konserva.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Konserva.Converters"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:utils="clr-namespace:Konserva.Utilities"
    Title="Settings">

    <Page.Resources>
        <!--  Стиль заголовка группы карточек  -->
        <Style x:Key="CardGroupHeader"
                TargetType="ui:TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

        <!--  Стиль заголовка настройки  -->
        <Style x:Key="SettingTitle"
                TargetType="ui:TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <!--  Стиль описания настройки  -->

        <Style x:Key="SettingDescription"
                TargetType="ui:TextBlock">
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Foreground"
                    Value="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <!--  Конвертер для позиционирования в группе слитных карточек  -->
        <converters:CardGroupPositionConverter x:Key="CardGroupPositionConverter"/>
    </Page.Resources>

    <Grid Margin="16,12,0,16"
            RowDefinitions="*,Auto">
        <ScrollViewer
            Grid.Row="0"
            Padding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}, Converter={StaticResource ScrollBarPadding}, ConverterParameter=16}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">

                <!--  =========================================================  -->
                <!--  Группа 1: Серверы (Общие настройки)  -->
                <!--  =========================================================  -->
                <StackPanel Margin="0,0,0,24">
                    <ui:TextBlock Style="{StaticResource CardGroupHeader}"
                            Text="{loc:Loc Settings_Servers}"/>

                    <StackPanel>
                        <!--  Карточка: Папка серверов (верхняя — скругление сверху)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0">
                            <Grid ColumnDefinitions="200,*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_Servers_Dir}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_Servers_DirDesc}"/>
                                </StackPanel>
                                <ui:TextBlock
                                    x:Name="ServersFolderPath"
                                    Grid.Column="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc Common_NotSelected}"
                                    TextTrimming="CharacterEllipsis"/>
                                <ui:Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="ChangeServersPath_Click"
                                    ToolTip="{loc:Loc Settings_Servers_Browse}">
                                    <ui:SymbolIcon FontSize="20"
                                            Symbol="FolderOpen20"/>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!--  Разделитель  -->
                        <Rectangle Height="1"
                                Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                        <!--  Карточка: Проверка обновлений (середина)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,0,1,0"
                            CornerRadius="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_CheckUpdates}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_CheckUpdates_Desc}"/>
                                </StackPanel>
                                <ui:DropDownButton
                                    x:Name="CheckUpdatesModeButton"
                                    Grid.Column="1"
                                    Content="{loc:Loc Settings_CheckUpdates_OnLaunch}">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem
                                                x:Name="CheckUpdatesOnLaunchItem"
                                                Click="CheckUpdatesModeMenuItem_Click"
                                                Header="{loc:Loc Settings_CheckUpdates_OnLaunch}"
                                                Tag="OnLaunch"/>
                                            <MenuItem
                                                x:Name="CheckUpdatesScheduledItem"
                                                Click="CheckUpdatesModeMenuItem_Click"
                                                Header="{loc:Loc Settings_CheckUpdates_Scheduled}"
                                                Tag="Scheduled"/>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </Grid>
                        </Border>

                        <!--  Разделитель (показан, когда чекбокс включён)  -->
                        <Rectangle
                            x:Name="UpdateIntervalSeparator"
                            Height="1"
                            Fill="{ui:ThemeResource ControlElevationBorderBrush}"
                            Visibility="Collapsed"/>

                        <!--  Карточка: Интервал проверки (середина)  -->
                        <Border
                            x:Name="UpdateIntervalCard"
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,0,1,0"
                            CornerRadius="0"
                            Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_CheckUpdates_Interval}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_CheckUpdates_Interval_Desc}"/>
                                </StackPanel>
                                <ui:DropDownButton
                                    x:Name="UpdateIntervalButton"
                                    Grid.Column="1"
                                    Content="24 ч">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="1 ч"
                                                Tag="1"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="2 ч"
                                                Tag="2"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="6 ч"
                                                Tag="6"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="12 ч"
                                                Tag="12"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="24 ч"
                                                Tag="24"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="2 д"
                                                Tag="48"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="3 д"
                                                Tag="72"/>
                                            <MenuItem
                                                Click="UpdateIntervalMenuItem_Click"
                                                Header="7 д"
                                                Tag="168"/>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </Grid>
                        </Border>

                        <!--  Разделитель между секцией проверки обновлений и треем  -->
                        <Rectangle Height="1"
                                Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                        <!--  Карточка: Режим сворачивания в трей (нижняя — скругление снизу)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,8,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_MinimizeToTray}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_MinimizeToTray_Desc}"/>
                                </StackPanel>
                                <ui:DropDownButton
                                    x:Name="MinimizeToTrayModeButton"
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Content="{loc:Loc Settings_MinimizeToTray_None}">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem
                                                x:Name="MinimizeToTrayNoneItem"
                                                Click="MinimizeToTrayModeMenuItem_Click"
                                                Header="{loc:Loc Settings_MinimizeToTray_None}"
                                                Tag="None"/>
                                            <MenuItem
                                                x:Name="MinimizeToTrayOnCloseItem"
                                                Click="MinimizeToTrayModeMenuItem_Click"
                                                Header="{loc:Loc Settings_MinimizeToTray_OnClose}"
                                                Tag="OnClose"/>
                                            <MenuItem
                                                x:Name="MinimizeToTrayOnMinimizeItem"
                                                Click="MinimizeToTrayModeMenuItem_Click"
                                                Header="{loc:Loc Settings_MinimizeToTray_OnMinimize}"
                                                Tag="OnMinimize"/>
                                            <MenuItem
                                                x:Name="MinimizeToTrayAlwaysItem"
                                                Click="MinimizeToTrayModeMenuItem_Click"
                                                Header="{loc:Loc Settings_MinimizeToTray_Always}"
                                                Tag="Always"/>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  =========================================================  -->
                <!--  Группа 2: Java  -->
                <!--  =========================================================  -->
                <StackPanel Margin="0,0,0,24">
                    <Grid
                        Margin="0,0,0,8"
                        VerticalAlignment="Center"
                        ColumnDefinitions="*,Auto">
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardGroupHeader}"
                            Text="{loc:Loc Settings_Java}"/>
                        <ui:Button
                            Grid.Column="1"
                            Padding="5"
                            VerticalAlignment="Center"
                            Click="AddJava_Click"
                            ToolTip="{loc:Loc Settings_Java_Add}">
                            <ui:SymbolIcon
                                Width="15"
                                Height="15"
                                FontSize="13"
                                Symbol="Add32"/>
                        </ui:Button>
                    </Grid>

                    <!--  Список Java — слитные карточки как в остальных группах  -->
                    <StackPanel>
                        <ItemsControl x:Name="JavaItemsControl"
                                AlternationCount="9999">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border
                                            Padding="12"
                                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                                            Tag="{Binding}">
                                            <Border.CornerRadius>
                                                <MultiBinding Converter="{StaticResource CardGroupPositionConverter}"
                                                        ConverterParameter="cornerRadius">
                                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                                            RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                    <Binding Path="Items.Count"
                                                            RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </Border.CornerRadius>
                                            <Border.BorderThickness>
                                                <MultiBinding Converter="{StaticResource CardGroupPositionConverter}"
                                                        ConverterParameter="borderThickness">
                                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                                            RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                    <Binding Path="Items.Count"
                                                            RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </Border.BorderThickness>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                    <ui:TextBlock
                                                        FontSize="13"
                                                        FontWeight="Medium"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis"/>
                                                    <ui:TextBlock
                                                        FontSize="11"
                                                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding Path}"
                                                        TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ui:Button
                                                    Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="DeleteJava_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="{loc:Loc Settings_Java_Delete}">
                                                    <ui:SymbolIcon
                                                        Filled="True"
                                                        FontSize="20"
                                                        Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                                        Symbol="Delete20"/>
                                                </ui:Button>
                                            </Grid>
                                        </Border>

                                        <!--  Разделитель между карточками (скрыт у последней)  -->
                                        <Rectangle Height="1"
                                                Fill="{ui:ThemeResource ControlElevationBorderBrush}">
                                            <Rectangle.Visibility>
                                                <MultiBinding Converter="{StaticResource CardGroupPositionConverter}"
                                                        ConverterParameter="separator">
                                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                                            RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                    <Binding Path="Items.Count"
                                                            RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </Rectangle.Visibility>
                                        </Rectangle>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBlock
                            x:Name="JavaEmptyText"
                            Margin="0,16"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                            Text="{loc:Loc Settings_Java_Empty}"
                            Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <!--  =========================================================  -->
                <!--  Группа 3: Внешний вид (Тема + Язык)  -->
                <!--  =========================================================  -->
                <StackPanel Margin="0,0,0,24">
                    <ui:TextBlock Style="{StaticResource CardGroupHeader}"
                            Text="{loc:Loc Settings_Appearance}"/>

                    <StackPanel>
                        <!--  Карточка: Тема (верхняя — скругление сверху)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_Theme}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_Theme_Desc}"/>
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Loc Settings_Theme_System}"
                                            Tag="System"/>
                                    <ComboBoxItem Content="{loc:Loc Settings_Theme_Dark}"
                                            Tag="Dark"/>
                                    <ComboBoxItem Content="{loc:Loc Settings_Theme_Light}"
                                            Tag="Light"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!--  Разделитель  -->
                        <Rectangle Height="1"
                                Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                        <!--  Карточка: Язык (нижняя — скругление снизу)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,8,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_Language}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_Language_Desc}"/>
                                </StackPanel>
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    Grid.Column="1"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Loc Settings_Language_System}"
                                            Tag="System"/>
                                    <ComboBoxItem Content="{loc:Loc Settings_Language_English}"
                                            Tag="en"/>
                                    <ComboBoxItem Content="{loc:Loc Settings_Language_Russian}"
                                            Tag="ru"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  =========================================================  -->
                <!--  Группа 4: Загрузки (Downloads)  -->
                <!--  =========================================================  -->
                <StackPanel Margin="0,0,0,24">
                    <ui:TextBlock Style="{StaticResource CardGroupHeader}"
                            Text="{loc:Loc Settings_Download}"/>

                    <StackPanel>
                        <!--  Карточка: Источник загрузки (единственная)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource SettingTitle}"
                                            Text="{loc:Loc Settings_DownloadSource}"/>
                                    <ui:TextBlock Style="{StaticResource SettingDescription}"
                                            Text="{loc:Loc Settings_DownloadSource_Desc}"/>
                                </StackPanel>
                                <ComboBox
                                    x:Name="DownloadSourceComboBox"
                                    Grid.Column="1"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="DownloadSourceComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Loc Settings_DownloadSource_VanillaApi}"
                                            Tag="VanillaApi"/>
                                    <ComboBoxItem Content="{loc:Loc Settings_DownloadSource_BMCLAPI}"
                                            Tag="BMCLAPI"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  =========================================================  -->
                <!--  Группа 5: О программе  -->
                <!--  =========================================================  -->
                <StackPanel Margin="0,0,0,24">
                    <ui:TextBlock Style="{StaticResource CardGroupHeader}"
                            Text="{loc:Loc Settings_About}"/>

                    <StackPanel>
                        <!--  Карточка: Информация о приложении (верхняя) + проверка обновлений  -->
                        <Border
                            Padding="16,16"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0">
                            <Grid ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">
                                <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Text="Konserva"/>
                                    <ui:TextBlock
                                        FontSize="13"
                                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{loc:Loc Settings_About_Description}"/>
                                </StackPanel>
                                <Button
                                    x:Name="CheckUpdatesButton"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    Click="CheckUpdatesButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            x:Name="UpToDateIcon"
                                            Margin="0,0,6,0"
                                            FontSize="16"
                                            Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}"
                                            Symbol="CheckmarkCircle24"
                                            Visibility="Collapsed"/>
                                        <ui:TextBlock x:Name="CheckUpdatesButtonText"
                                                Text="{loc:Loc Settings_CheckForUpdates}"/>
                                        <ui:ProgressRing
                                            x:Name="UpdateWaveDots"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="Collapsed"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!--  Разделитель  -->
                        <Rectangle Height="1"
                                Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                        <!--  Карточка: Модлоадеры (нижняя)  -->
                        <Border
                            Padding="16,12"
                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,8,8">
                            <StackPanel>
                                <ui:TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Text="{loc:Loc Settings_About_ModalLoaders}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:InfoBadge
                                        Margin="0,0,4,0"
                                        Severity="Attention"
                                        Value="Vanilla"/>
                                    <ui:InfoBadge
                                        Margin="0,0,4,0"
                                        Severity="Caution"
                                        Value="Forge"/>
                                    <ui:InfoBadge
                                        Margin="0,0,4,0"
                                        Severity="Caution"
                                        Value="NeoForge"/>
                                    <ui:InfoBadge
                                        Margin="0,0,4,0"
                                        Severity="Caution"
                                        Value="Fabric"/>
                                    <ui:InfoBadge
                                        Margin="0,0,4,0"
                                        Severity="Caution"
                                        Value="Quilt"/>
                                    <ui:InfoBadge
                                        Margin="0,0,4,0"
                                        Severity="Attention"
                                        Value="Paper"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  InfoBar для уведомления о смене языка  -->
        <ui:InfoBar
            x:Name="LanguageChangeInfoBar"
            Title="{loc:Loc Settings_Language}"
            Grid.Row="1"
            Margin="0,8,0,0"
            IsClosable="True"
            IsOpen="False"
            Message="{loc:Loc Message_RestartRequired}"
            Severity="Informational"/>

        <!--  InfoBar для уведомления об успешной установке Java  -->
        <ui:InfoBar
            x:Name="JavaSuccessInfoBar"
            Grid.Row="1"
            Margin="0,8,0,0"
            IsClosable="True"
            IsOpen="False"
            Severity="Success"/>
    </Grid>
</Page>
