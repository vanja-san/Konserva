<Page
    x:Class="Konserva.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings">

    <Page.Resources>
        <!--  Стиль для заголовка Expander с иконкой  -->
        <Style x:Key="ExpanderHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="16,0,16,16" RowDefinitions="Auto,*,Auto">
        <!--  Заголовок и индикатор сохранения  -->
        <Grid
            Grid.Row="0"
            Margin="6,12"
            ColumnDefinitions="Auto,*">
            <!--  Заголовок  -->
            <ui:TextBlock
                Grid.Column="0"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="{loc:Loc Settings_Title}" />
            <!--  Индикатор сохранения (справа)  -->
            <StackPanel
                x:Name="SaveNotification"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <ui:SymbolIcon Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}" Symbol="Checkmark20" />
                <ui:TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#2ecc71"
                    Text="{loc:Loc Message_SettingsSaved}" />
            </StackPanel>
        </Grid>

        <!--  CardExpander с настройками  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Общие настройки и Java  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="True">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="TaskListSquaresettings20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="{loc:Loc Settings_Servers}" />
                    </ui:CardExpander.Header>
                    <Border Margin="8">
                        <StackPanel>
                            <!--  Папка серверов  -->
                            <Grid Margin="0,0,0,16" ColumnDefinitions="200,*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{loc:Loc Settings_Servers_Directory}" />
                                    <ui:TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_Servers_Browse}" />
                                </StackPanel>
                                <ui:TextBlock
                                    x:Name="ServersFolderPath"
                                    Grid.Column="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center"
                                    Text="Не выбрано"
                                    TextTrimming="CharacterEllipsis" />
                                <ui:Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="ChangeServersPath_Click"
                                    ToolTip="{loc:Loc Settings_Servers_Browse}">
                                    <ui:SymbolIcon FontSize="20" Symbol="FolderOpen20" />
                                </ui:Button>
                            </Grid>

                            <!--  Java по умолчанию  -->
                            <Grid ColumnDefinitions="200,*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{loc:Loc Settings_Java}" />
                                    <ui:TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_Java_Add}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="JavaComboBox"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    Margin="8,0"
                                    Padding="8,6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="JavaComboBox_SelectionChanged" />
                                <ui:Button
                                    Grid.Column="2"
                                    Padding="8"
                                    VerticalAlignment="Center"
                                    Click="AddJava_Click"
                                    ToolTip="{loc:Loc Settings_Java_Add}">
                                    <ui:SymbolIcon FontSize="13" Symbol="Add32" />
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>

                <!--  Настройки RAM и приложения  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Ram20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="{loc:Loc Settings_RAM_Min}" />
                    </ui:CardExpander.Header>
                    <Border Padding="8">
                        <StackPanel>
                            <!--  Настройки RAM  -->
                            <ui:TextBlock
                                Margin="0,0,0,16"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{loc:Loc Settings_RAM_Min_Label}" />

                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{loc:Loc Settings_RAM_Min_Label}" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_RAM_Min_Desc}" />
                                    <ui:TextBox
                                        x:Name="DefaultRamMin"
                                        Width="120"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        TextChanged="DefaultRamMin_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{loc:Loc Settings_RAM_Max_Label}" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_RAM_Max_Desc}" />
                                    <ui:TextBox
                                        x:Name="DefaultRamMax"
                                        Width="120"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        TextChanged="DefaultRamMax_TextChanged" />
                                </StackPanel>
                            </Grid>

                            <!--  Настройки приложения  -->
                            <ui:TextBlock
                                Margin="0,16,0,16"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{loc:Loc Settings_App}" />

                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{loc:Loc Settings_CheckUpdates}" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_CheckUpdates_Desc}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="CheckUpdatesBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="CheckUpdatesBox_Checked"
                                    Unchecked="CheckUpdatesBox_Unchecked" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>

                <!--  Тема и внешний вид  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Color20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="{loc:Loc Settings_Theme}" />
                    </ui:CardExpander.Header>
                    <Border Padding="8">
                        <StackPanel>
                            <!--  Выбор темы  -->
                            <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{loc:Loc Settings_Theme}" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_Theme_Desc}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeComboBox"
                                    Grid.Column="1"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Loc Settings_Theme_System}" Tag="System" />
                                    <ComboBoxItem Content="{loc:Loc Settings_Theme_Dark}" Tag="Dark" />
                                    <ComboBoxItem Content="{loc:Loc Settings_Theme_Light}" Tag="Light" />
                                </ComboBox>
                            </Grid>

                            <!--  Выбор языка  -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{loc:Loc Settings_Language}" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{loc:Loc Settings_Language_Desc}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    Grid.Column="1"
                                    Width="150"
                                    VerticalAlignment="Center"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Loc Settings_Language_System}" Tag="System" />
                                    <ComboBoxItem Content="{loc:Loc Settings_Language_English}" Tag="en" />
                                    <ComboBoxItem Content="{loc:Loc Settings_Language_Russian}" Tag="ru" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>

                <!--  О программе  -->
                <ui:CardExpander
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Info20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="{loc:Loc Settings_About}" />
                    </ui:CardExpander.Header>
                    <Border Padding="8">
                        <StackPanel>
                            <ui:TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Text="Konserva" />
                            <ui:TextBlock FontSize="14" Foreground="Gray">
                                <Run Text="{loc:Loc Settings_About_Version}" />
                                <Run Text="1.2.0" />
                            </ui:TextBlock>
                            <ui:TextBlock
                                FontSize="13"
                                Foreground="Gray"
                                Text="{loc:Loc Settings_About_Description}" />
                            <ui:TextBlock
                                Margin="0,21,0,8"
                                FontSize="13"
                                FontWeight="Bold"
                                Text="{loc:Loc Settings_About_ModalLoaders}" />
                            <WrapPanel>
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Info"
                                    Content="{loc:Loc ModLoader_Vanilla}" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="{loc:Loc ModLoader_Forge}" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="{loc:Loc ModLoader_NeoForge}" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="{loc:Loc ModLoader_Fabric}" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="{loc:Loc ModLoader_Quilt}" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Info"
                                    Content="{loc:Loc ModLoader_Paper}" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Info"
                                    Content="{loc:Loc ModLoader_Purpur}" />
                                <ui:Badge Margin="0,0,8,8" Appearance="Caution">
                                    <ui:Badge.Content>
                                        <ui:TextBlock>
                                            <Run Text="{loc:Loc ModLoader_Spigot}" />
                                            <Run Text=" (" />
                                            <Run Text="{loc:Loc Common_InDevelopment}" />
                                            <Run Text=")" />
                                        </ui:TextBlock>
                                    </ui:Badge.Content>
                                </ui:Badge>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!--  InfoBar для уведомления о смене языка  -->
        <ui:InfoBar
            x:Name="LanguageChangeInfoBar"
            Title="{loc:Loc Settings_Language}"
            Grid.Row="2"
            Margin="0,8,0,0"
            IsClosable="True"
            IsOpen="False"
            Message="{loc:Loc Message_RestartRequired}"
            Severity="Informational" />
    </Grid>
</Page>
