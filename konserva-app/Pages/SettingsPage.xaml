<Page
    x:Class="Konserva.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Настройки">

    <Page.Resources>
        <!--  Стиль для заголовка Expander с иконкой  -->
        <Style x:Key="ExpanderHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="16,0,16,16" RowDefinitions="Auto,*,Auto">
        <!--  Заголовок и индикатор сохранения  -->
        <Grid
            Grid.Row="0"
            Margin="6,12"
            ColumnDefinitions="Auto,*">
            <!--  Заголовок  -->
            <ui:TextBlock
                Grid.Column="0"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="Настройки" />
            <!--  Индикатор сохранения (справа)  -->
            <StackPanel
                x:Name="SaveNotification"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <ui:SymbolIcon Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}" Symbol="Checkmark20" />
                <ui:TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#2ecc71"
                    Text="Настройки сохранены" />
            </StackPanel>
        </Grid>

        <!--  CardExpander с настройками  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Общие настройки и Java  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="True">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="TaskListSquaresettings20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Общие настройки" />
                    </ui:CardExpander.Header>
                    <Border Margin="8">
                        <StackPanel>
                            <!--  Папка серверов  -->
                            <Grid Margin="0,0,0,16" ColumnDefinitions="200,*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="Папка серверов" />
                                    <ui:TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="Расположение всех серверов" />
                                </StackPanel>
                                <ui:TextBlock
                                    x:Name="ServersFolderPath"
                                    Grid.Column="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center"
                                    Text="Не выбрано"
                                    TextTrimming="CharacterEllipsis" />
                                <ui:Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="ChangeServersPath_Click"
                                    ToolTip="Изменить папку">
                                    <ui:SymbolIcon FontSize="20" Symbol="FolderOpen20" />
                                </ui:Button>
                            </Grid>

                            <!--  Java по умолчанию  -->
                            <Grid ColumnDefinitions="200,*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="Java по умолчанию" />
                                    <ui:TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="Используется для запуска серверов" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="JavaComboBox"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    Margin="8,0"
                                    Padding="8,6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    SelectionChanged="JavaComboBox_SelectionChanged" />
                                <ui:Button
                                    Grid.Column="2"
                                    Padding="8"
                                    VerticalAlignment="Center"
                                    Click="AddJava_Click"
                                    ToolTip="Добавить Java">
                                    <ui:SymbolIcon FontSize="13" Symbol="Add32" />
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>

                <!--  Настройки RAM и приложения  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Ram20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Память и приложение" />
                    </ui:CardExpander.Header>
                    <Border Padding="8">
                        <StackPanel>
                            <!--  Настройки RAM  -->
                            <ui:TextBlock
                                Margin="0,0,0,16"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Оперативная память по умолчанию" />

                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Минимум RAM (MB)" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="Начальный объем памяти" />
                                    <ui:TextBox
                                        x:Name="DefaultRamMin"
                                        Width="120"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        TextChanged="DefaultRamMin_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Максимум RAM (MB)" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="Максимальный объем памяти" />
                                    <ui:TextBox
                                        x:Name="DefaultRamMax"
                                        Width="120"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        TextChanged="DefaultRamMax_TextChanged" />
                                </StackPanel>
                            </Grid>

                            <!--  Настройки приложения  -->
                            <ui:TextBlock
                                Margin="0,16,0,16"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Приложение" />

                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Проверка обновлений" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="Автоматически проверять обновления" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="CheckUpdatesBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="CheckUpdatesBox_Checked"
                                    Unchecked="CheckUpdatesBox_Unchecked" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>

                <!--  Тема и внешний вид  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Color20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Тема и внешний вид" />
                    </ui:CardExpander.Header>
                    <Border Padding="8">
                        <StackPanel>
                            <!--  Выбор темы  -->
                            <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Тема оформления" />
                                    <ui:TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="Выберите тему приложения" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeComboBox"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    Padding="8,6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Как в системе" Tag="System" />
                                    <ComboBoxItem Content="Тёмная" Tag="Dark" />
                                    <ComboBoxItem Content="Светлая" Tag="Light" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>

                <!--  О программе  -->
                <ui:CardExpander
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Info20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="О программе" />
                    </ui:CardExpander.Header>
                    <Border Padding="8">
                        <StackPanel>
                            <ui:TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Text="Konserva" />
                            <ui:TextBlock
                                FontSize="14"
                                Foreground="Gray"
                                Text="Версия 1.0.0" />
                            <ui:TextBlock
                                FontSize="13"
                                Foreground="Gray"
                                Text="Менеджер серверов Minecraft" />
                            <ui:TextBlock
                                Margin="0,21,0,8"
                                FontSize="13"
                                FontWeight="Bold"
                                Text="Поддерживаемые модлоадеры:" />
                            <WrapPanel>
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Info"
                                    Content="Vanilla" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="Forge" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="NeoForge" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="Fabric" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Success"
                                    Content="Quilt" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Info"
                                    Content="Paper" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Info"
                                    Content="Purpur" />
                                <ui:Badge
                                    Margin="0,0,8,8"
                                    Appearance="Caution"
                                    Content="Spigot (В разработке)" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
