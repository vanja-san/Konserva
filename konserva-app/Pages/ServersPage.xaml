<Page
    x:Class="Konserva.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="">
    <Page.Resources>
        <!--  Без переопределения — чекбоксы используют тему по умолчанию  -->
    </Page.Resources>
    <Grid Margin="16"
          RowDefinitions="Auto,*">
        <!--  Поиск и фильтры  -->
        <Border Grid.Row="0"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--  Поиск с watermark  -->
                <Grid
                    Grid.Column="0"
                    Height="32.62"
                    Margin="0,0,8,0">
                    <ui:TextBox
                        x:Name="SearchBox"
                        GotFocus="SearchBox_GotFocus"
                        LostFocus="SearchBox_LostFocus"
                        TextChanged="SearchBox_TextChanged"/>
                    <ui:TextBlock
                        x:Name="SearchPlaceholder"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="{loc:Loc ServersPage_Search}"
                        Visibility="Visible"/>
                </Grid>

                <!--  Sort DropDownButton  -->
                <ui:DropDownButton
                    x:Name="SortButton"
                    Grid.Column="1"
                    Width="50"
                    Height="33"
                    Margin="0,0,8,0"
                    Padding="0"
                    ToolTip="{loc:Loc ServersPage_SortBy}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem
                                FontWeight="SemiBold"
                                Header="{loc:Loc ServersPage_Sort_Header}"
                                IsEnabled="False"/>
                            <MenuItem
                                x:Name="SortNameItem"
                                Click="SortMenuItem_Click"
                                Header="{loc:Loc ServersPage_Sort_Name}"
                                IsCheckable="True"
                                IsChecked="True"
                                Tag="Name"/>
                            <MenuItem
                                x:Name="SortStatusItem"
                                Click="SortMenuItem_Click"
                                Header="{loc:Loc ServersPage_Sort_Status}"
                                IsCheckable="True"
                                Tag="Status"/>
                            <MenuItem
                                x:Name="SortTypeItem"
                                Click="SortMenuItem_Click"
                                Header="{loc:Loc ServersPage_Sort_Type}"
                                IsCheckable="True"
                                Tag="Type"/>
                            <MenuItem
                                x:Name="SortVersionItem"
                                Click="SortMenuItem_Click"
                                Header="{loc:Loc ServersPage_Sort_Version}"
                                IsCheckable="True"
                                Tag="Version"/>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                    <ui:SymbolIcon FontSize="16"
                                   Symbol="ArrowSort24"/>
                </ui:DropDownButton>

                <!--  Filter DropDownButton  -->
                <ui:DropDownButton
                    x:Name="FilterButton"
                    Grid.Column="2"
                    Width="50"
                    Height="33"
                    Margin="0,0,8,0"
                    Padding="0"
                    ToolTip="{loc:Loc ServersPage_Filter_All}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <!--  Type filter  -->
                            <MenuItem
                                FontWeight="SemiBold"
                                Header="{loc:Loc ServersPage_Filter_All}"
                                IsEnabled="False"/>
                            <MenuItem
                                x:Name="TypeAllItem"
                                Click="TypeMenuItem_Click"
                                Header="{loc:Loc ServersPage_Filter_All}"
                                IsCheckable="True"
                                IsChecked="True"
                                Tag="All"/>
                            <MenuItem
                                Click="TypeMenuItem_Click"
                                Header="Vanilla"
                                IsCheckable="True"
                                Tag="Vanilla"/>
                            <MenuItem
                                Click="TypeMenuItem_Click"
                                Header="Forge"
                                IsCheckable="True"
                                Tag="Forge"/>
                            <MenuItem
                                Click="TypeMenuItem_Click"
                                Header="NeoForge"
                                IsCheckable="True"
                                Tag="NeoForge"/>
                            <MenuItem
                                Click="TypeMenuItem_Click"
                                Header="Fabric"
                                IsCheckable="True"
                                Tag="Fabric"/>
                            <MenuItem
                                Click="TypeMenuItem_Click"
                                Header="Paper"
                                IsCheckable="True"
                                Tag="Paper"/>
                            <Separator/>
                            <!--  Status filter  -->
                            <MenuItem
                                FontWeight="SemiBold"
                                Header="{loc:Loc ServersPage_Filter_Status}"
                                IsEnabled="False"/>
                            <MenuItem
                                x:Name="StatusAllItem"
                                Click="StatusMenuItem_Click"
                                Header="{loc:Loc ServersPage_Filter_AllServers}"
                                IsCheckable="True"
                                IsChecked="True"
                                Tag="All"/>
                            <MenuItem
                                Click="StatusMenuItem_Click"
                                Header="{loc:Loc ServersPage_Filter_Running}"
                                IsCheckable="True"
                                Tag="Running"/>
                            <MenuItem
                                Click="StatusMenuItem_Click"
                                Header="{loc:Loc ServersPage_Filter_Stopped}"
                                IsCheckable="True"
                                Tag="Stopped"/>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                    <ui:SymbolIcon FontSize="16"
                                   Symbol="Filter12"/>
                </ui:DropDownButton>

                <!--  Create Server Button  -->
                <ui:Button
                    Grid.Column="3"
                    Width="33"
                    Height="33"
                    Padding="0"
                    Click="CreateServer_Click"
                    ToolTip="{loc:Loc ServersPage_Create}">
                    <ui:SymbolIcon FontSize="13"
                                   Symbol="Add32"/>
                </ui:Button>
            </Grid>
        </Border>

        <!--  Список серверов  -->
        <Border Grid.Row="1">
            <Grid>
                <ScrollViewer CanContentScroll="True"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ServersList"
                                  ItemsSource="{Binding FilteredServers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardAction
                                    Margin="0,0,0,8"
                                    Padding="12,6"
                                    AutomationProperties.Name="{Binding Name}"
                                    Click="ServerCard_Click"
                                    IsChevronVisible="True"
                                    KeyDown="ServerCard_KeyDown"
                                    Tag="{Binding}">
                                    <ui:CardAction.Icon>
                                        <ui:SymbolIcon
                                            Filled="True"
                                            FontSize="20"
                                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                            Symbol="ServerSurface16"/>
                                    </ui:CardAction.Icon>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!--  Название и информация  -->
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">
                                            <ui:TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"/>
                                            <StackPanel Margin="0,4,0,0"
                                                        Orientation="Horizontal">
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding McVersion}"/>
                                                </ui:TextBlock>
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="  •  "/>
                                                <ui:TextBlock FontSize="12"
                                                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding ModLoader.Type}"/>
                                                </ui:TextBlock>
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="  •  "/>
                                                <ui:TextBlock FontSize="12"
                                                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{loc:Loc ServersPage_Port}"/>
                                                    <Run Text="{Binding Port}"/>
                                                </ui:TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Кнопки управления  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="10"
                                                Height="10"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            <ui:Button
                                                x:Name="PlayButton"
                                                Margin="0,0,8,0"
                                                Padding="4"
                                                AutomationProperties.Name="Play or Stop"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=DataContext.PlayCommand}"
                                                CommandParameter="{Binding}"
                                                Tag="{Binding}">
                                                <ui:SymbolIcon FontSize="20">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol"
                                                                    Value="Play20"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}"
                                                                             Value="True">
                                                                    <Setter Property="Symbol"
                                                                            Value="Stop20"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="0,0,8,0"
                                                Padding="4"
                                                AutomationProperties.Name="Open folder"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=DataContext.OpenFolderCommand}"
                                                CommandParameter="{Binding}"
                                                Tag="{Binding}"
                                                ToolTip="{loc:Loc ServersPage_OpenFolder}">
                                                <ui:SymbolIcon FontSize="20"
                                                               Symbol="Folder20"/>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="0,0,12,0"
                                                Padding="4"
                                                AutomationProperties.Name="Delete server"
                                                Click="Delete_Click"
                                                Tag="{Binding}"
                                                ToolTip="{loc:Loc ServersPage_Delete}">
                                                <ui:SymbolIcon FontSize="20"
                                                               Symbol="Delete20"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  Нет серверов  -->
                <StackPanel
                    x:Name="NoServersPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasNoServers, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="{loc:Loc ServersPage_NoServers}"/>
                    <ui:TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="{loc:Loc ServersPage_NoServers_Description}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
