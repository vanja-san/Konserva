<Page
    x:Class="Konserva.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Servers">
    <Grid Margin="16" RowDefinitions="Auto,*">
        <!--  Поиск и фильтры  -->
        <Border Grid.Row="0" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!--  Поиск с watermark  -->
                <Grid
                    Grid.Column="0"
                    Height="32.62"
                    Margin="0,0,8,0">
                    <ui:TextBox
                        x:Name="SearchBox"
                        GotFocus="SearchBox_GotFocus"
                        LostFocus="SearchBox_LostFocus"
                        TextChanged="SearchBox_TextChanged" />
                    <ui:TextBlock
                        x:Name="SearchPlaceholder"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="{loc:Loc ServersPage_Search}"
                        Visibility="Visible" />
                </Grid>

                <!--  Фильтр по типу  -->
                <ComboBox
                    x:Name="FilterType"
                    Grid.Column="1"
                    Width="110"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    VerticalAlignment="Center"
                    ContextMenu="{x:Null}"
                    SelectionChanged="FilterType_SelectionChanged">
                    <ComboBoxItem
                        Content="{loc:Loc ServersPage_Filter_All}"
                        IsSelected="True"
                        Tag="All" />
                    <ComboBoxItem Content="Vanilla" Tag="Vanilla" />
                    <ComboBoxItem Content="Forge" Tag="Forge" />
                    <ComboBoxItem Content="NeoForge" Tag="NeoForge" />
                    <ComboBoxItem Content="Fabric" Tag="Fabric" />
                    <ComboBoxItem Content="Paper" Tag="Paper" />
                    <ComboBoxItem Content="Purpur" Tag="Purpur" />
                    <ComboBoxItem
                        Content="Quilt"
                        IsEnabled="False"
                        Tag="Quilt" />
                </ComboBox>

                <!--  Фильтр по статусу  -->
                <ComboBox
                    x:Name="FilterStatus"
                    Grid.Column="2"
                    Width="130"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    ContextMenu="{x:Null}"
                    SelectionChanged="FilterStatus_SelectionChanged">
                    <ComboBoxItem
                        Content="{loc:Loc ServersPage_Filter_AllServers}"
                        IsSelected="True"
                        Tag="All" />
                    <ComboBoxItem Content="{loc:Loc ServersPage_Filter_Running}" Tag="Running" />
                    <ComboBoxItem Content="{loc:Loc ServersPage_Filter_Stopped}" Tag="Stopped" />
                </ComboBox>
                <!--  Кнопка создать сервер  -->
                <ui:Button
                    Grid.Column="3"
                    Width="33"
                    Height="33"
                    Padding="0"
                    Click="CreateServer_Click"
                    ToolTip="{loc:Loc ServersPage_Create}">
                    <ui:SymbolIcon FontSize="13" Symbol="Add32" />
                </ui:Button>
            </Grid>
        </Border>
        <!--  Список серверов  -->
        <Border Grid.Row="1">
            <Grid>
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="ServersList"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardAction
                                    Margin="0,0,0,8"
                                    Padding="12,6"
                                    AutomationProperties.Name="{Binding Name}"
                                    Click="ServerCard_Click"
                                    IsChevronVisible="True"
                                    KeyDown="ServerCard_KeyDown"
                                    Tag="{Binding}">
                                    <ui:CardAction.Icon>
                                        <ui:SymbolIcon
                                            Filled="True"
                                            FontSize="20"
                                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                            Symbol="ServerSurface16" />
                                    </ui:CardAction.Icon>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!--  Название и информация  -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding McVersion}" />
                                                </ui:TextBlock>
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="  •  " />
                                                <ui:TextBlock FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding ModLoader.Type}" />
                                                </ui:TextBlock>
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="  •  " />
                                                <ui:TextBlock FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{loc:Loc ServersPage_Port}" />
                                                    <Run Text="{Binding Port}" />
                                                </ui:TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Кнопки управления  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <ui:Button
                                                x:Name="PlayButton"
                                                Margin="0,0,8,0"
                                                Padding="4"
                                                AutomationProperties.Name="Play or Stop"
                                                Click="Play_Click"
                                                Tag="{Binding}">
                                                <ui:SymbolIcon FontSize="20">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Play20" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Symbol" Value="Stop20" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="0,0,8,0"
                                                Padding="4"
                                                AutomationProperties.Name="Open folder"
                                                Click="OpenFolder_Click"
                                                Tag="{Binding}"
                                                ToolTip="{loc:Loc ServersPage_OpenFolder}">
                                                <ui:SymbolIcon FontSize="20" Symbol="Folder20" />
                                            </ui:Button>
                                            <ui:Button
                                                Margin="0,0,12,0"
                                                Padding="4"
                                                AutomationProperties.Name="Delete server"
                                                Click="Delete_Click"
                                                Tag="{Binding}"
                                                ToolTip="{loc:Loc ServersPage_Delete}">
                                                <ui:SymbolIcon FontSize="20" Symbol="Delete20" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  Нет серверов  -->
                <StackPanel
                    x:Name="NoServersPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontTypography="BodyStrong"
                        Foreground="Gray"
                        Text="{loc:Loc ServersPage_NoServers}" />
                    <ui:TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontTypography="Body"
                        Foreground="Gray"
                        Text="{loc:Loc ServersPage_NoServers_Description}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
