<Page
    x:Class="Konserva.Pages.CreateServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CreateServer"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Стиль заголовка настройки (как на SettingsPage)  -->
        <Style x:Key="SettingTitle"
               TargetType="ui:TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
        </Style>

    </Page.Resources>

    <Grid RowDefinitions="*,Auto">
        <!--  Content (скроллируемая форма)  -->
        <ScrollViewer
            Grid.Row="0"
            Padding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}, Converter={StaticResource ScrollBarPadding}, ConverterParameter=16}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,0,16">

                <!--  Группа карточек: Параметры сервера  -->
                <StackPanel Margin="0,0,0,24">

                    <!--  Карточка: Название + Версия (верхняя)  -->
                    <Border
                        Padding="16,12"
                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0">
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Style="{StaticResource SettingTitle}"
                                              Text="{loc:Loc CreateServer_Name}"/>
                                <ui:TextBox x:Name="ServerNameBox"
                                            MaxLength="50"
                                            TextChanged="ServerNameBox_TextChanged"
                                            LostFocus="ServerNameBox_LostFocus"/>
                                <ui:TextBlock
                                    x:Name="ServerNameValidation"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="#DC5050"
                                    Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Style="{StaticResource SettingTitle}"
                                              Text="{loc:Loc CreateServer_MinecraftVersion}"/>
                                <ComboBox
                                    x:Name="McVersionBox"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="McVersionBox_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Разделитель  -->
                    <Rectangle Height="1"
                               Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                    <!--  Карточка: Модлоадер + Версия загрузчика  -->
                    <Border
                        Padding="16,12"
                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1,0,1,0"
                        CornerRadius="0">
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Style="{StaticResource SettingTitle}"
                                              Text="{loc:Loc CreateServer_ModLoader}"/>
                                <ComboBox
                                    x:Name="ModLoaderBox"
                                    ContextMenu="{x:Null}"
                                    SelectionChanged="ModLoaderBox_SelectionChanged">
                                    <ComboBoxItem
                                        Content="Vanilla"
                                        IsSelected="True"
                                        Tag="Vanilla"/>
                                    <ComboBoxItem Content="Forge"
                                                  Tag="Forge"/>
                                    <ComboBoxItem Content="NeoForge"
                                                  Tag="NeoForge"/>
                                    <ComboBoxItem Content="Fabric"
                                                  Tag="Fabric"/>
                                    <ComboBoxItem Content="Quilt"
                                                  Tag="Quilt"/>
                                    <ComboBoxItem Content="Paper"
                                                  Tag="Paper"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Style="{StaticResource SettingTitle}"
                                              Text="{loc:Loc CreateServer_ModLoaderVersion}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox
                                        x:Name="LoaderVersionBox"
                                        Grid.Column="0"
                                        ContextMenu="{x:Null}"
                                        IsEnabled="False"/>
                                    <ui:ProgressRing
                                        x:Name="LoaderProgressRing"
                                        Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Разделитель  -->
                    <Rectangle Height="1"
                               Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                    <!--  Карточка: Snapshot фильтр  -->
                    <Border
                        Padding="16,12"
                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1,0,1,0"
                        CornerRadius="0">
                        <CheckBox
                            x:Name="ShowSnapshotsBox"
                            VerticalAlignment="Center"
                            Content="{loc:Loc CreateServer_Filter_Stable}"
                            ToolTip="{loc:Loc CreateServer_Filter_Stable}"/>
                    </Border>

                    <!--  Разделитель  -->
                    <Rectangle Height="1"
                               Fill="{ui:ThemeResource ControlElevationBorderBrush}"/>

                    <!--  Карточка: Расположение сервера (нижняя)  -->
                    <Border
                        Padding="16,12"
                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8">
                        <Grid RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*">
                            <ui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{loc:Loc CreateServer_Folder}"
                                ToolTip="{loc:Loc CreateServer_Folder}"/>
                            <Grid
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                ColumnDefinitions="*,Auto">
                                <ui:TextBox
                                    x:Name="ServerPathBox"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    IsReadOnly="True"/>
                                <ui:Button
                                    Grid.Column="1"
                                    Padding="16,8"
                                    Click="BrowsePath_Click"
                                    Content="{loc:Loc CreateServer_Browse}"/>
                            </Grid>
                            <ui:TextBlock
                                x:Name="ServerPathValidation"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="16,4,0,0"
                                FontSize="11"
                                Foreground="#DC5050"
                                Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  Кнопки и прогресс (фиксировано внизу)  -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,16"
            Padding="8"
            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1,1,1,1"
            CornerRadius="8">
            <Grid Margin="0"
                  ColumnDefinitions="Auto,*,Auto">
                <!--  Кнопка Импорт  -->
                <ui:Button
                    x:Name="ImportButton"
                    Grid.Column="0"
                    Click="Import_Click"
                    Content="{loc:Loc CreateServer_Import}"/>

                <!--  Статус установки с анимацией волны  -->
                <StackPanel
                    x:Name="ProgressPanel"
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <ui:ProgressRing
                        x:Name="ProgressRing"
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        IsIndeterminate="True"/>
                    <ui:TextBlock
                        x:Name="ProgressText"
                        FontSize="12"
                        Text="{loc:Loc Common_Preparing}"
                        TextTrimming="CharacterEllipsis"/>
                    <ui:Button
                        x:Name="ShowLogButton"
                        Margin="8,0,0,0"
                        Padding="4,0"
                        MinWidth="0"
                        FontSize="11"
                        Appearance="Secondary"
                        Content="{loc:Loc Installer_ShowLog}"
                        Visibility="Collapsed"
                        Click="ShowLogButton_Click"/>
                </StackPanel>

                <!--  Кнопка Создать/Отмена  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        x:Name="ValidationIcon"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Filled="True"
                        FontSize="20"
                        Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Warning20"
                        Visibility="Collapsed"/>
                    <ui:Button
                        x:Name="ActionOrCancelButton"
                        Appearance="Primary"
                        Click="ActionOrCancel_Click"
                        Content="{loc:Loc CreateServer_Create}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
