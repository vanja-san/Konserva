<ui:FluentWindow
    x:Class="Konserva.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Konserva.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:local="clr-namespace:Konserva"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Konserva.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:utils="clr-namespace:Konserva.Utilities"
    Width="550"
    Height="700"
    MinWidth="550"
    MinHeight="500"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Title Bar  -->
        <ui:TitleBar Grid.Row="0" Height="32">
            <ui:TitleBar.Header>
                <Grid ColumnDefinitions="Auto,Auto">
                    <!--  Кнопка "Назад"  -->
                    <ui:Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        Padding="12,10"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        CornerRadius="0"
                        Visibility="Collapsed">
                        <ui:SymbolIcon FontSize="13" Symbol="ArrowLeft32" />
                    </ui:Button>
                    <!--  Иконка и заголовок (прозрачны для мыши)  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                        <ui:ImageIcon
                            Width="16"
                            Height="16"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="pack://application:,,,/Assets/app-icon.ico" />
                        <ui:TextBlock
                            x:Name="WindowTitleText"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="NavSettings"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavButton_Click"
                        CornerRadius="0"
                        ToolTip="{loc:Loc MainWindow_Settings}">
                        <ui:SymbolIcon FontSize="18" Symbol="Settings20" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!--  Content Frame for navigation  -->
        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            JournalOwnership="OwnsJournal"
            NavigationUIVisibility="Hidden" />

        <!--  Status Bar  -->
        <Border
            Grid.Row="2"
            Padding="12,8"
            VerticalAlignment="Center"
            Background="{ui:ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <!--  Total Servers  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    ToolTip="{loc:Loc StatusBar_TotalServers}">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="16"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Symbol="Server24" />
                    <ui:TextBlock
                        x:Name="StatusTotalServers"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="16"
                        Text="0"
                        ToolTip="{loc:Loc StatusBar_TotalServers}" />
                </StackPanel>

                <!--  Running  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    ToolTip="{loc:Loc StatusBar_Running}">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="14"
                        Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}"
                        Symbol="CheckmarkCircle24" />
                    <ui:TextBlock
                        x:Name="StatusRunningServers"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="16"
                        Text="0"
                        ToolTip="{loc:Loc StatusBar_Running}" />
                </StackPanel>

                <!--  Memory  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    ToolTip="{loc:Loc StatusBar_Memory}">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="16"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Symbol="Storage24" />
                    <ui:TextBlock
                        x:Name="StatusMemoryUsage"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="16"
                        Text="0 MB"
                        ToolTip="{loc:Loc StatusBar_Memory}" />
                </StackPanel>

                <!--  Java  -->
                <StackPanel
                    Grid.Column="3"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="14"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Symbol="Braces24"
                        ToolTip="{x:Null}" />
                    <ui:TextBlock
                        x:Name="StatusJava"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="16"
                        Text="{loc:Loc StatusBar_Java_NotConfigured}">
                        <ui:TextBlock.ToolTip>
                            <ToolTip Content="{loc:Loc StatusBar_Java_NotConfigured}" />
                        </ui:TextBlock.ToolTip>
                    </ui:TextBlock>
                </StackPanel>

                <!--  Version / Update Notification  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:TextBlock
                        x:Name="VersionText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        LineHeight="16"
                        Text="{utils:AppVersion Prefix=v}" />
                    <controls:UpdateNotification x:Name="UpdateNotificationControl" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Snackbar Presenter — поверх всего контента  -->
        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="0,0,0,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Panel.ZIndex="100" />

        <!--  ContentDialog Host — для модальных диалогов  -->
        <ui:ContentDialogHost
            x:Name="ContentDialogPresenter"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="200" />
    </Grid>
</ui:FluentWindow>
