<ui:FluentWindow
    x:Class="Konserva.Dialogs.CreateServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CreateServer"
    Width="480"
    Height="485"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Manual"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="0" RowDefinitions="Auto,Auto">
        <!--  Title Bar  -->
        <ui:TitleBar
            x:Name="AppTitleBar"
            Title="{loc:Loc CreateServer_Title}"
            Grid.Row="0"
            Height="32"
            Padding="8,0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Content  -->
        <Border Grid.Row="1">
            <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <!--  1. Название сервера  -->
                <StackPanel Grid.Row="0">
                    <ui:TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Text="{loc:Loc CreateServer_Name}" />
                    <ui:TextBox x:Name="ServerNameBox" TextChanged="ServerNameBox_TextChanged" />
                </StackPanel>

                <!--  2. Модлоадер  -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <ui:TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Text="{loc:Loc CreateServer_ModLoader}" />
                    <ComboBox
                        x:Name="ModLoaderBox"
                        ContextMenu="{x:Null}"
                        SelectionChanged="ModLoaderBox_SelectionChanged">
                        <ComboBoxItem
                            Content="Vanilla"
                            IsSelected="True"
                            Tag="Vanilla" />
                        <ComboBoxItem Content="Forge" Tag="Forge" />
                        <ComboBoxItem Content="NeoForge" Tag="NeoForge" />
                        <ComboBoxItem Content="Fabric" Tag="Fabric" />
                        <ComboBoxItem Content="Quilt" Tag="Quilt" />
                        <ComboBoxItem Content="Paper" Tag="Paper" />
                        <ComboBoxItem Content="Purpur" Tag="Purpur" />
                        <ComboBoxItem
                            Content="Spigot"
                            IsEnabled="False"
                            Tag="Spigot" />
                    </ComboBox>
                </StackPanel>

                <!--  3. Версия Minecraft и модлоадера (рядом)  -->
                <Grid
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    ColumnDefinitions="*,16,*">
                    <!--  Версия Minecraft  -->
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Text="{loc:Loc CreateServer_MinecraftVersion}" />
                        <ComboBox
                            x:Name="McVersionBox"
                            ContextMenu="{x:Null}"
                            SelectionChanged="McVersionBox_SelectionChanged" />
                    </StackPanel>

                    <!--  Версия модлоадера  -->
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Text="{loc:Loc CreateServer_ModLoader}" />
                        <ComboBox
                            x:Name="LoaderVersionBox"
                            ContextMenu="{x:Null}"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <!--  4. Показывать snapshot версии  -->
                <CheckBox
                    x:Name="ShowSnapshotsBox"
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    VerticalAlignment="Center"
                    Content="{loc:Loc CreateServer_Filter_Stable}"
                    ToolTip="{loc:Loc CreateServer_Filter_Stable}" />

                <!--  5. Расположение сервера  -->
                <StackPanel Grid.Row="4" Margin="0,16,0,24">
                    <ui:TextBlock
                        Margin="0,0,0,16"
                        FontSize="13"
                        Text="{loc:Loc CreateServer_Folder}"
                        ToolTip="{loc:Loc CreateServer_Folder}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBox
                            x:Name="ServerPathBox"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            IsReadOnly="True" />
                        <ui:Button
                            Grid.Column="1"
                            Padding="16,8"
                            Click="BrowsePath_Click"
                            Content="{loc:Loc CreateServer_Browse}" />
                    </Grid>
                </StackPanel>

                <!--  6. Кнопки  -->
                <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto">
                    <ui:Button
                        x:Name="ImportButton"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Click="Import_Click"
                        Content="{loc:Loc CreateServer_Import}" />
                    <ui:Button
                        x:Name="CancelButton"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Content="{loc:Loc Common_Cancel}" />
                    <ui:Button
                        x:Name="CreateButton"
                        Grid.Column="3"
                        Click="Create_Click"
                        Content="{loc:Loc CreateServer_Create}" />
                </Grid>

                <!--  7. Индикатор прогресса  -->
                <ProgressBar
                    x:Name="ProgressPanel"
                    Grid.Row="6"
                    Height="4"
                    Margin="0,8,0,0"
                    VerticalAlignment="Bottom"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
