<UserControl
    x:Class="Konserva.Controls.ServerPropertiesEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Margin="0">

    <UserControl.Resources>
        <Style x:Key="ExpanderHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <!--  Основной контент  -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Основные настройки  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="True">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="TaskListSquareSettings20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Основные настройки" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Порт сервера" />
                        <ui:TextBox
                            x:Name="ServerPortBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="25565" />

                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Server IP" />
                        <ui:TextBox
                            x:Name="ServerIpBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="" />

                        <ui:TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Макс. игроков" />
                        <ui:TextBox
                            x:Name="MaxPlayersBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="20" />

                        <ui:TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Дальность прорисовки" />
                        <ui:TextBox
                            x:Name="ViewDistanceBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="10" />

                        <ui:TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Дальность симуляции" />
                        <ui:TextBox
                            x:Name="SimulationDistanceBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="10" />

                        <ui:TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="MOTD (описание)" />
                        <ui:TextBox
                            x:Name="MotdBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center" />
                    </Grid>
                </ui:CardExpander>

                <!--  Режим игры  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="True">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Server20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Режим игры" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Режим игры" />
                        <ComboBox
                            x:Name="GamemodeBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="4">
                            <ComboBoxItem Content="Выживание (Survival)" Tag="survival" />
                            <ComboBoxItem Content="Творчество (Creative)" Tag="creative" />
                            <ComboBoxItem Content="Приключение (Adventure)" Tag="adventure" />
                            <ComboBoxItem Content="Наблюдатель (Spectator)" Tag="spectator" />
                        </ComboBox>

                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Сложность" />
                        <ComboBox
                            x:Name="DifficultyBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4">
                            <ComboBoxItem Content="Мирный (Peaceful)" Tag="peaceful" />
                            <ComboBoxItem Content="Лёгкий (Easy)" Tag="easy" />
                            <ComboBoxItem Content="Обычный (Normal)" Tag="normal" />
                            <ComboBoxItem Content="Сложный (Hard)" Tag="hard" />
                        </ComboBox>

                        <ui:TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Хардкор" />
                        <CheckBox
                            x:Name="HardcoreBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4"
                            Content="Режим хардкора" />

                        <ui:TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="PvP" />
                        <CheckBox
                            x:Name="PvpBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4"
                            Content="Разрешить PvP" />

                        <ui:TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Командные блоки" />
                        <CheckBox
                            x:Name="CommandBlocksBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="4"
                            Content="Разрешить командные блоки" />
                    </Grid>
                </ui:CardExpander>

                <!--  Мир  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="True">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Globe20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Мир" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Имя мира" />
                        <ui:TextBox
                            x:Name="LevelNameBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center" />

                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Сиды (seed)" />
                        <ui:TextBox
                            x:Name="LevelSeedBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center" />

                        <ui:TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Тип мира" />
                        <ComboBox
                            x:Name="LevelTypeBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center">
                            <ComboBoxItem Content="Обычный (Normal)" Tag="minecraft:normal" />
                            <ComboBoxItem Content="Плоский (Flat)" Tag="minecraft:flat" />
                            <ComboBoxItem Content="Крупные биомы (Large Biomes)" Tag="minecraft:large_biomes" />
                            <ComboBoxItem Content="Амплифицированный (Amplified)" Tag="minecraft:amplified" />
                            <ComboBoxItem Content="Один биом (Single Biome)" Tag="minecraft:single_biome_surface" />
                        </ComboBox>

                        <ui:TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Макс. размер мира" />
                        <ui:TextBox
                            x:Name="MaxWorldSizeBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="29999984" />

                        <ui:TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Генерация структур" />
                        <CheckBox
                            x:Name="GenerateStructuresBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="4"
                            Content="Генерировать структуры" />

                        <ui:TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Доступ в Незер" />
                        <CheckBox
                            x:Name="AllowNetherBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="4"
                            Content="Разрешить Незер" />
                    </Grid>
                </ui:CardExpander>

                <!--  Безопасность и ограничения  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="True">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="ShieldLock20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Безопасность и ограничения" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Проверка лицензии" />
                        <CheckBox
                            x:Name="OnlineModeBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="4"
                            Content="Проверять лицензию (online-mode)" />

                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Белый список" />
                        <CheckBox
                            x:Name="WhiteListBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4"
                            Content="Использовать whitelist" />

                        <ui:TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Принудительный whitelist" />
                        <CheckBox
                            x:Name="EnforceWhitelistBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4"
                            Content="Принудительный whitelist" />

                        <ui:TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Безопасный профиль" />
                        <CheckBox
                            x:Name="EnforceSecureProfileBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4"
                            Content="Требовать безопасный профиль" />

                        <ui:TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Полёты" />
                        <CheckBox
                            x:Name="AllowFlightBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="4"
                            Content="Разрешить полёты" />
                    </Grid>
                </ui:CardExpander>

                <!--  RCON  -->
                <ui:CardExpander
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Password16" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="RCON (удалённое управление)" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,*"
                        RowDefinitions="Auto,Auto,Auto,Auto">
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Включить RCON" />
                        <CheckBox
                            x:Name="EnableRconBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="4"
                            Content="Включить RCON" />

                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Пароль RCON" />
                        <ui:TextBox
                            x:Name="RconPasswordBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center" />

                        <ui:TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="Порт RCON" />
                        <ui:TextBox
                            x:Name="RconPortBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="100"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="25575" />

                        <ui:TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,4"
                            VerticalAlignment="Center"
                            Text="RCON IP" />
                        <ui:TextBox
                            x:Name="RconIpBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center" />
                    </Grid>
                </ui:CardExpander>
                <!--  Дополнительные настройки  -->
                <ui:CardExpander
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="TextboxMore20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="Дополнительные настройки" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Защита спавна" />
                        <ui:TextBox
                            x:Name="SpawnProtectionBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="100"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="16" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Радиус спавна" />
                        <ui:TextBox
                            x:Name="SpawnRadiusBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="100"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="10" />
                        <ui:TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Уровень прав OP" />
                        <ui:TextBox
                            x:Name="OpPermissionLevelBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="100"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="4" />
                        <ui:TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Max tick time (мс)" />
                        <ui:TextBox
                            x:Name="MaxTickTimeBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="100"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="60000" />
                        <ui:TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Сжатие сети" />
                        <ui:TextBox
                            x:Name="NetworkCompressionBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="100"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="256" />
                        <ui:TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Спавн NPC" />
                        <CheckBox
                            x:Name="SpawnNpcsBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="4"
                            Content="Спавнить NPC" />
                        <ui:TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Спавн животных" />
                        <CheckBox
                            x:Name="SpawnAnimalsBox"
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="4"
                            Content="Спавнить животных" />
                        <ui:TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Спавн монстров" />
                        <CheckBox
                            x:Name="SpawnMonstersBox"
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="4"
                            Content="Спавнить монстров" />
                        <ui:TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Включенные датапаки" />
                        <ui:TextBox
                            x:Name="InitialEnabledPacksBox"
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center"
                            Text="vanilla" />
                        <ui:TextBlock
                            Grid.Row="9"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Отключённые датапаки" />
                        <ui:TextBox
                            x:Name="InitialDisabledPacksBox"
                            Grid.Row="9"
                            Grid.Column="1"
                            Margin="4"
                            VerticalAlignment="Center" />
                    </Grid>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
        <!--  Нижняя панель (кнопки действий)  -->
        <Border Grid.Row="1" Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ui:TextBlock
                    x:Name="StatusMessage"
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontStyle="Italic" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        x:Name="ResetButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="Reset_Click"
                        ToolTip="Сбросить server.properties на значения по умолчанию">
                        <ui:SymbolIcon FontSize="20" Symbol="ArrowReset20" />
                    </ui:Button>
                    <ui:Button
                        x:Name="LoadButton"
                        Width="32"
                        Height="32"
                        Margin="8,0,8,0"
                        Padding="0"
                        Click="Load_Click"
                        ToolTip="Загрузить">
                        <ui:SymbolIcon FontSize="20" Symbol="ArrowSyncCircle20" />
                    </ui:Button>
                    <ui:Button
                        x:Name="SaveButton"
                        Padding="8,4"
                        VerticalContentAlignment="Center"
                        Click="Save_Click"
                        ToolTip="Сохранить изменения server.properties">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="Save20" />
                            <ui:TextBlock VerticalAlignment="Top" Text="Сохранить" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>