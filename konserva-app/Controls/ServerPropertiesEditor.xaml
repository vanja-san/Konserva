                            <ui:TextBlock Text="{loc:Loc ServerProperties_EnableJmxMonitoring}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_EnableJmxMonitoring_Desc}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="EnableJmxMonitoringBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />

                        <StackPanel
                            x:Name="EnableCodeOfConductBoxParent"
                            Grid.Row="4"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_EnableCodeOfConduct}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_EnableCodeOfConduct_Desc}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="EnableCodeOfConductBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />

                        <StackPanel
                            x:Name="BugReportLinkBoxParent"
                            Grid.Row="5"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_BugReportLink}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_BugReportLink_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="BugReportLinkBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="12,4,0,4" />

                        <StackPanel
                            x:Name="TextFilteringConfigBoxParent"
                            Grid.Row="6"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_TextFilteringConfig}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_TextFilteringConfig_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="TextFilteringConfigBox"
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="12,4,0,4" />

                        <StackPanel
                            x:Name="TextFilteringVersionBoxParent"
                            Grid.Row="7"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_TextFilteringVersion}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_TextFilteringVersion_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="TextFilteringVersionBox"
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="12,4,0,4"
                            Text="0" />
                    </Grid>
                </ui:CardExpander>

                <!--  Legacy Settings  -->
                <ui:CardExpander
                    x:Name="LegacyExpander"
                    Margin="0,0,0,8"
                    Padding="12"
                    ContentPadding="8"
                    IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon
                            Filled="True"
                            FontSize="20"
                            Symbol="Warning20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Style="{StaticResource ExpanderHeaderStyle}" Text="{loc:Loc ServerProperties_Deprecated}" />
                    </ui:CardExpander.Header>
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <StackPanel
                            x:Name="SpawnNpcsBoxParent"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_SpawnNPCs}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_SpawnNPCs_Desc}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="SpawnNpcsBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />

                        <StackPanel
                            x:Name="SpawnAnimalsBoxParent"
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_SpawnAnimals}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_SpawnAnimals_Desc}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="SpawnAnimalsBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />

                        <StackPanel
                            x:Name="SpawnMonstersBoxParent"
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_SpawnMonsters}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_SpawnMonsters_Desc}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="SpawnMonstersBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />

                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Loc ServerProperties_AllowNether}" />
                            <ui:TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerProperties_AllowNether_Desc}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
        <!--  Нижняя панель (кнопки действий)  -->
        <Border Grid.Row="1" Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ui:TextBlock
                    x:Name="StatusMessage"
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontStyle="Italic" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        x:Name="ResetButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="Reset_Click"
                        ToolTip="{loc:Loc ServerProperties_Reset}">
                        <ui:SymbolIcon FontSize="20" Symbol="ArrowReset20" />
                    </ui:Button>
                    <ui:Button
                        x:Name="LoadButton"
                        Width="32"
                        Height="32"
                        Margin="8,0,8,0"
                        Padding="0"
                        Click="Load_Click"
                        ToolTip="{loc:Loc ServerProperties_Refresh}">
                        <ui:SymbolIcon FontSize="20" Symbol="ArrowSyncCircle20" />
                    </ui:Button>
                    <ui:Button
                        x:Name="SaveButton"
                        Padding="8,4"
                        VerticalContentAlignment="Center"
                        Click="Save_Click"
                        ToolTip="{loc:Loc ServerProperties_Save}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="20"
                                Symbol="Save20" />
                            <ui:TextBlock VerticalAlignment="Top" Text="{loc:Loc ServerProperties_Save}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>