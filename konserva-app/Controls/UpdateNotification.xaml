<UserControl x:Class="Konserva.Controls.UpdateNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    VerticalAlignment="Center"
    Visibility="Collapsed">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Версия с иконкой -->
        <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ArrowUpload24"
                FontSize="12"
                Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}"
                Margin="0,0,4,0"
                VerticalAlignment="Center"/>
            <ui:TextBlock x:Name="VersionText"
                FontSize="12"
                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопка обновления / статус -->
        <ui:Button x:Name="UpdateButton"
            Padding="6,2"
            Margin="0,0,0,0"
            Appearance="Transparent"
            BorderThickness="0"
            Click="UpdateButton_Click"
            VerticalAlignment="Center"
            ToolTip="{Binding UpdateTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ui:TextBlock x:Name="UpdateButtonText"
                FontSize="11"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"/>
        </ui:Button>
    </StackPanel>
</UserControl>
