<UserControl
    x:Class="Konserva.Controls.Sections.ServerPluginsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid RowDefinitions="Auto,*">
        <!--  Тулбар  -->
        <Border
            Grid.Row="0"
            Padding="12,8,8,8"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Filled="True"
                        FontSize="20"
                        Symbol="AppsListDetail20" />
                    <ui:TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="{loc:Loc ServerDetail_Plugins_List}" />
                    <ui:InfoBadge
                        x:Name="PluginsCountBadge"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Value="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        x:Name="ToggleAllPluginsBtn"
                        Height="32"
                        Padding="8,0,8,0"
                        Click="ToggleAllPlugins_Click"
                        ToolTip="{loc:Loc ServerDetail_Plugins_ToggleAll}">
                        <ui:TextBlock Text="{loc:Loc ServerDetail_Plugins_ToggleAll_Enable}" />
                    </ui:Button>
                    <ui:Button
                        x:Name="OpenPluginsFolderBtn"
                        Width="32"
                        Height="32"
                        Margin="8,0,8,0"
                        Padding="0"
                        Click="OpenPluginsFolder_Click"
                        ToolTip="{loc:Loc ServerDetail_Plugins_OpenFolder}">
                        <ui:SymbolIcon FontSize="20" Symbol="FolderOpen20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Список плагинов  -->
        <Border
            Grid.Row="1"
            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,4,4">
            <ScrollViewer
                Margin="12,12,0,12"
                Padding="0,0,12,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PluginsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl
                                Margin="0,0,0,8"
                                Padding="12,8,8,8"
                                ContextMenuOpening="PluginCard_ContextMenuOpening"
                                Opacity="{Binding Enabled, Converter={StaticResource BoolToOpacity}}"
                                Tag="{Binding}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon
                                        Filled="True"
                                        FontSize="20"
                                        Symbol="LightbulbFilament20" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <ui:TextBlock
                                        FontSize="14"
                                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </ui:CardControl.Header>
                                <ui:CardControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="DeletePlugin_Click"
                                            Header="{loc:Loc ServerDetail_Plugins_Delete}"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" Symbol="Delete20" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:CardControl.ContextMenu>
                                <ui:Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PluginMoreMenu_Click"
                                    Tag="{Binding}">
                                    <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal20" />
                                </ui:Button>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>

</UserControl>