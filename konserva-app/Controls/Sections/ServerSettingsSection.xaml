<UserControl
    x:Class="Konserva.Controls.Sections.ServerSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Konserva.Controls"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta">

    <ScrollViewer
        x:Name="SettingsScrollViewer"
        Margin="0,8,-16,0"
        Padding="0,0,16,0"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--  Баннер: сервер запущен  -->
            <Border
                x:Name="SettingsRunningBanner"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{ui:ThemeResource SystemFillColorCautionBackgroundBrush}"
                CornerRadius="6"
                Visibility="Collapsed">
                <Grid ColumnDefinitions="Auto,*">
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Filled="True"
                        FontSize="20"
                        Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                        Symbol="Warning48" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{loc:Loc ServerDetail_Settings_RunningWarning}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!--  Основные настройки  -->
            <ui:CardExpander
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="TaskListSquaresettings20" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerProperties_General}" />
                        <ui:TextBlock
                            x:Name="GeneralSaveStatus"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto">
                    <Grid
                        Grid.Row="0"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <ui:TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{loc:Loc ServerDetail_Settings_General}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_General_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="SettingName"
                            Grid.Column="1"
                            MinWidth="200"
                            MaxWidth="250"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            LostFocus="Setting_LostFocus"
                            MaxLength="50" />
                    </Grid>
                </Grid>
            </ui:CardExpander>

            <!--  Выделение памяти  -->
            <ui:CardExpander
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="Storage20" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Settings_RAM}" />
                        <ui:TextBlock
                            x:Name="RamSaveStatus"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto,Auto">
                    <Grid
                        Grid.Row="0"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <ui:TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{loc:Loc ServerDetail_Settings_RAM_Min}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_RAM_Min_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="SettingRamMin"
                            Grid.Column="1"
                            Width="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            LostFocus="Setting_LostFocus"
                            PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                            TextAlignment="Center" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Vertical">
                            <ui:TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{loc:Loc ServerDetail_Settings_RAM_Max}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_RAM_Max_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="SettingRamMax"
                            Grid.Column="1"
                            Width="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            LostFocus="Setting_LostFocus"
                            PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                            TextAlignment="Center" />
                    </Grid>
                </Grid>
            </ui:CardExpander>

            <!--  Авто-рестарт  -->
            <ui:CardExpander
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="Power20" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Settings_AutoRestart}" />
                        <ui:TextBlock
                            x:Name="AutoRestartSaveStatus"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto,Auto">
                    <Grid
                        Grid.Row="0"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_AutoRestart_Enable}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_AutoRestart_Desc}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="SettingAutoRestart"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Setting_Click" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="0,8"
                        ColumnDefinitions="*,200">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_AutoRestart_Delay}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_AutoRestart_Delay_Desc}" />
                        </StackPanel>
                        <ui:TextBox
                            x:Name="SettingAutoRestartDelay"
                            Grid.Column="1"
                            MinWidth="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            LostFocus="Setting_LostFocus"
                            PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                            TextAlignment="Center" />
                    </Grid>
                </Grid>
            </ui:CardExpander>

            <!--  Настройки Java  -->
            <ui:CardExpander
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="SquareHintApps20" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Java}" />
                        <ui:TextBlock
                            x:Name="JavaSaveStatus"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto,Auto,Auto">
                    <Grid
                        Grid.Row="0"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_Java_Auto}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_Java_Auto_Desc}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="SettingJavaAutoSelect"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Setting_Click"
                            IsChecked="True" />
                    </Grid>
                    <Grid
                        x:Name="JavaSelectionGrid"
                        Grid.Row="1"
                        Margin="0,8"
                        ColumnDefinitions="150,*">
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc ServerDetail_Settings_Java_Version}" />
                        <ComboBox
                            x:Name="SettingJavaComboBox"
                            Grid.Column="1"
                            MinWidth="200"
                            HorizontalAlignment="Right"
                            SelectionChanged="SettingJavaComboBox_SelectionChanged" />
                    </Grid>

                    <!--  JVM аргументы  -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_JvmArgs}" />
                                <ui:TextBlock
                                    FontSize="11"
                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc ServerDetail_Settings_JvmArgs_Desc}" />
                            </StackPanel>
                            <ui:TextBox
                                x:Name="SettingJvmArgs"
                                Grid.Row="1"
                                MinHeight="100"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                FontSize="12"
                                LostFocus="SettingJvmArgs_LostFocus"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Grid>
                </Grid>
            </ui:CardExpander>

            <!--  UPnP Проброс порта  -->
            <ui:CardExpander
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="Wifi120" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Upnp}" />
                        <ui:TextBlock
                            x:Name="UpnpSaveStatus"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto,Auto,Auto">

                    <!--  Row 0: вкл/выкл UPnP  -->
                    <Grid
                        Grid.Row="0"
                        Margin="0,16"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Upnp_Enable}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Upnp_Enable_Desc}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="SettingEnableUpnp"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="SettingEnableUpnp_Click" />
                    </Grid>

                    <!--  Row 1: результат + кнопки проверки  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:TextBlock
                            x:Name="UpnpCheckResultText"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Visibility="Collapsed" />
                        <ui:SymbolIcon
                            x:Name="UpnpCheckResultIcon"
                            Margin="0,0,12,0"
                            Filled="True"
                            FontSize="20"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="CheckUpnpButton"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Click="CheckUpnpButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:SpinnerRing
                                    x:Name="CheckUpnpProgress"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="CheckUpnpText"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc ServerDetail_Upnp_Check}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button
                            x:Name="CheckPortButton"
                            MinWidth="120"
                            Appearance="Primary"
                            Click="CheckPortButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:SpinnerRing
                                    x:Name="CheckPortProgress"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="CheckPortText"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc ServerDetail_Upnp_CheckPort}" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!--  Row 2: адрес  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock
                                x:Name="UpnpAddressText"
                                FontSize="13"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <ui:Button
                            x:Name="CopyAddressButton"
                            Grid.Column="1"
                            MinWidth="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CopyAddressButton_Click"
                            Content="{loc:Loc ServerDetail_Upnp_CopyAddress}"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </ui:CardExpander>

            <!--  Обновление модов  -->
            <ui:CardExpander
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="Cube20" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_Settings_Mods}" />
                        <ui:TextBlock
                            x:Name="ModsSaveStatus"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto">
                    <Grid
                        Grid.Row="0"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_Settings_ModBackup}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_Settings_ModBackup_Desc}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="SettingModBackup"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Setting_Click" />
                    </Grid>
                </Grid>
            </ui:CardExpander>

            <!--  Обновление сервера (загрузчик)  -->
            <ui:CardExpander
                x:Name="UpdateServerCard"
                Margin="0,0,0,8"
                Padding="12"
                ContentPadding="8"
                Visibility="Collapsed">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="20"
                        Symbol="ArrowClockwise20" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_UpdateLoader_Title}" />
                </ui:CardExpander.Header>
                <Grid Margin="8,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <!--  Установленная версия  -->
                    <Grid
                        Grid.Row="0"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <ui:TextBlock VerticalAlignment="Center" Text="{loc:Loc ServerDetail_UpdateLoader_CurrentLabel}" />
                        <ui:TextBlock
                            x:Name="UpdateCurrentVersionText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="—" />
                    </Grid>

                    <!--  Доступные версии  -->
                    <Grid
                        Grid.Row="1"
                        Margin="0,8"
                        ColumnDefinitions="180,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_UpdateLoader_VersionsLabel}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_UpdateLoader_Versions_Desc}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="UpdateLoaderVersionBox"
                            Grid.Column="1"
                            MinWidth="180"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MaxDropDownHeight="200" />
                    </Grid>

                    <!--  Резервная копия  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_UpdateLoader_BackupLabel}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_UpdateLoader_Backup_Desc}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="SettingUpdateBackup"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!--  Уведомление об обновлении  -->
                    <Grid
                        Grid.Row="3"
                        Margin="0,8"
                        ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontSize="13" Text="{loc:Loc ServerDetail_UpdateLoader_NotifyLabel}" />
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{loc:Loc ServerDetail_UpdateLoader_Notify_Desc}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="SettingUpdateNotifications"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="SettingUpdateNotifications_Click" />
                    </Grid>

                    <!--  Статус  -->
                    <ui:TextBlock
                        x:Name="UpdateStatusText"
                        Grid.Row="4"
                        Margin="0,4"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!--  Прогресс + кнопка обновления  -->
                    <Grid
                        Grid.Row="5"
                        Margin="0,8,0,0"
                        ColumnDefinitions="*,Auto">
                        <Grid
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="UpdateLogProgress"
                                Height="4"
                                VerticalAlignment="Center"
                                vio:ProgressBarHelper.IsEnabled="True"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                            <ui:TextBlock
                                x:Name="UpdateResultText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>
                        <ui:Button
                            x:Name="UpdateServerButton"
                            Grid.Column="1"
                            MinWidth="140"
                            HorizontalAlignment="Right"
                            Appearance="Primary"
                            Click="UpdateServerButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:SpinnerRing
                                    x:Name="UpdateProgress"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed" />
                                <ui:TextBlock
                                    x:Name="UpdateButtonText"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc ServerDetail_UpdateLoader_Update}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
