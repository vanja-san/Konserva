<UserControl
    x:Class="Konserva.Controls.Sections.ServerModsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Konserva.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid RowDefinitions="Auto,*">
        <!--  Тулбар  -->
        <Border
            Grid.Row="0"
            Padding="12,8,8,8"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Filled="True"
                        FontSize="20"
                        Symbol="AppsListDetail20" />
                    <ui:TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="{loc:Loc ServerDetail_Mods_List}" />
                    <ui:InfoBadge
                        x:Name="ModsCountBadge"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Value="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        x:Name="CheckModUpdatesBtn"
                        Width="32"
                        Height="32"
                        Padding="0" Margin="0,0,8,0"
                        Click="CheckModUpdates_Click"
                        ToolTip="{loc:Loc ServerDetail_Mods_CheckUpdates_Tooltip}">
                        <ui:SymbolIcon FontSize="20" Symbol="ArrowClockwise20" />
                    </ui:Button>
                    <Grid
                        x:Name="UpdateAllModsContainer"
                        Width="32"
                        Height="32"
                        Margin="0,0,8,0"
                        Visibility="Collapsed">
                        <ui:Button
                            x:Name="UpdateAllModsBtn"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="UpdateAllMods_Click"
                            ToolTip="{loc:Loc ServerDetail_Mods_UpdateAll_Tooltip}">
                            <ui:SymbolIcon FontSize="20" Symbol="ArrowUp20" />
                        </ui:Button>
                        <ui:ProgressRing
                            x:Name="UpdateAllModsProgress"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                        <ui:SymbolIcon
                            x:Name="UpdateAllModsCheck"
                            FontSize="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}"
                            Symbol="Checkmark20"
                            Visibility="Collapsed" />
                    </Grid>
                    <ui:Button
                        x:Name="ToggleAllModsBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="ToggleAllMods_Click"
                        ToolTip="{loc:Loc ServerDetail_Mods_ToggleAll}">
                        <ui:SymbolIcon FontSize="20" Symbol="ToggleMultiple20" />
                    </ui:Button>
                    <ui:Button
                        x:Name="OpenModsFolderBtn"
                        Width="32"
                        Height="32"
                        Margin="8,0,8,0"
                        Padding="0"
                        Click="OpenModsFolder_Click"
                        ToolTip="{loc:Loc ServerDetail_Mods_OpenFolder}">
                        <ui:SymbolIcon FontSize="20" Symbol="FolderOpen20" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Список модов  -->
        <Border
            Grid.Row="1"
            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,4,4">
            <Grid RowDefinitions="Auto,*">
                <ui:InfoBar
                    x:Name="ModUpdateStatusBar"
                    Grid.Row="0"
                    Margin="12,8,12,0"
                    IsClosable="False"
                    IsOpen="False"
                    RenderTransformOrigin="0.5,0.5"
                    Severity="Informational">
                    <ui:InfoBar.RenderTransform>
                        <ScaleTransform x:Name="ModUpdateStatusBarScale" ScaleX="1" ScaleY="1" />
                    </ui:InfoBar.RenderTransform>
                </ui:InfoBar>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="12,12,0,12"
                    Padding="0,0,12,0"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardControl
                                    Margin="0,0,0,8"
                                    Padding="12,8,8,8"
                                    ContextMenuOpening="ModCard_ContextMenuOpening"
                                    Opacity="{Binding Enabled, Converter={StaticResource BoolToOpacity}}"
                                    Tag="{Binding}">
                                    <ui:CardControl.Icon>
                                        <ui:SymbolIcon
                                            Filled="True"
                                            FontSize="20"
                                            Symbol="Cube20" />
                                    </ui:CardControl.Icon>
                                    <ui:CardControl.Header>
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock
                                                    FontSize="14"
                                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ui:TextBlock
                                                    Margin="6,0,0,0"
                                                    FontSize="11"
                                                    VerticalAlignment="Bottom"
                                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Version}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <ui:TextBlock
                                                FontSize="11"
                                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding LatestVersion, StringFormat='New: {0}'}"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:CardControl.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="DeleteMod_Click"
                                                Header="{loc:Loc ServerDetail_Mods_Delete}"
                                                Tag="{Binding}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" Symbol="Delete20" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:CardControl.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="UpdateMod_Click"
                                                Tag="{Binding}"
                                                ToolTip="{Binding UpdateTooltip}"
                                                Visibility="{Binding IsNotUpdating, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon
                                                    Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                    FontSize="16"
                                                    Symbol="ArrowUp20" />
                                            </ui:Button>
                                            <ui:ProgressRing
                                                Width="16"
                                                Height="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                IsIndeterminate="{Binding IsUpdating}"
                                                Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:SymbolIcon
                                                FontSize="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}"
                                                Symbol="Checkmark20"
                                                Visibility="{Binding UpdateSucceeded, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <ui:Button
                                            Margin="4,0,0,0"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="ModMoreMenu_Click"
                                            Tag="{Binding}">
                                            <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal20" />
                                        </ui:Button>
                                    </StackPanel>
                                </ui:CardControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</UserControl>