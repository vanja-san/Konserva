<ui:FluentWindow x:Class="Konserva.Controls.InstallLogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:Konserva.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="650"
                 Height="450"
                 MinWidth="400"
                 MinHeight="250"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="LogTextBox"
                 Grid.Row="0"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="11"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="8"
                 Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                 Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                 BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                 BorderThickness="1"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <ui:Button x:Name="CopyButton"
                       Appearance="Secondary"
                       Content="{loc:Loc Common_Copy}"
                       Margin="0,0,8,0"
                       Click="CopyButton_Click"/>
            <ui:Button x:Name="CloseButton"
                       Appearance="Primary"
                       Content="{loc:Loc Common_Close}"
                       Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
