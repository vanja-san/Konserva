# EditorConfig for Konserva project

root = true

# All files
[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# C#/XAML: достаточно UTF-8. .NET SDK читает исходники без BOM как UTF-8,
# поэтому BOM не обязателен (в репозитории он есть примерно у трети файлов —
# это наследие Visual Studio, а не требование сборки).
[*.{cs,xaml}]
charset = utf-8

# XML files
[*.{xml,config,props,targets,csproj,resx}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Batch files
[*.bat]
end_of_line = crlf
